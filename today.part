
<style>
.tgrid{display:grid;grid-template-columns:minmax(0,1.25fr) minmax(0,1fr);gap:16px;align-items:start}
@media (max-width:900px){.tgrid{grid-template-columns:1fr}}
.tsec{display:flex;flex-direction:column;gap:16px;min-width:0}
.panel h3 .sub{display:block;font-family:var(--body);text-transform:none;letter-spacing:0;font-weight:400;font-size:12px;line-height:1.4;margin-top:2px}
.pickrow .who{flex:1 1 auto}
.pickrow .r.stack{flex-direction:column;align-items:flex-end;gap:3px;text-align:right}
.statline{display:flex;gap:6px;align-items:baseline;justify-content:flex-end;white-space:nowrap}
.statline .sub{font-size:12px}
.pickline{display:flex;gap:6px;align-items:center;margin-top:4px;flex-wrap:wrap}
.pickline b{font-family:var(--mono);font-weight:600}
.edge.big{font-size:15px;padding:4px 8px}
.pickrow{display:flex;justify-content:space-between;align-items:center;gap:10px;padding:10px 0;border-top:1px solid var(--line);text-decoration:none;color:inherit}
.pickrow:first-of-type{border-top:0}
.pickrow:hover .pname{text-decoration:underline}
.pickrow .r{display:flex;gap:8px;align-items:center;flex-shrink:0}
.big2{font-family:var(--mono);font-weight:600;font-size:16px}
.leanchip{font-size:11px;font-weight:700;letter-spacing:.04em;padding:2px 7px;border-radius:4px;background:var(--accent-soft);color:var(--accent);white-space:nowrap}
.newsrow{padding:8px 0;border-top:1px solid var(--line);font-size:13px}
.newsrow:first-of-type{border-top:0}
.rec{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin:8px 0}
.rec div{background:var(--raised);border-radius:6px;padding:10px}
.rec b{display:block;font-family:var(--mono);font-size:20px}
.rec span{font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:var(--muted)}
.bet{border-top:1px solid var(--line);padding:10px 0}
.bet:first-of-type{border-top:0}
.bet .top{display:flex;justify-content:space-between;gap:8px;align-items:center}
.res{font-size:11px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;padding:2px 8px;border-radius:4px;white-space:nowrap}
.res.win{background:var(--pos-soft);color:var(--pos)} .res.loss{background:var(--neg-soft);color:var(--neg)} .res.pending{background:var(--raised);color:var(--muted)} .res.void,.res.push{background:var(--warn-soft);color:var(--warn)}
.legline{font-size:12px;color:var(--muted);display:flex;gap:6px;align-items:center;flex-wrap:wrap;margin-top:3px}
.legline i{font-style:normal;font-weight:700}
.legline i.win{color:var(--pos)} .legline i.loss{color:var(--neg)}
details.recent summary{cursor:pointer;font-size:12px;font-weight:600;color:var(--muted);margin:10px 0 6px}
details.recent[open] summary{color:var(--fg)}
.ghead{display:flex;justify-content:space-between;align-items:center;gap:8px;margin:14px 0 2px;padding:8px 10px;background:var(--raised);border-radius:6px;font-weight:600;text-decoration:none;color:inherit}
.ghead:first-of-type{margin-top:6px}
.ghead .sub{font-weight:400;white-space:nowrap}
details.gsum>summary{list-style:none;cursor:pointer}
details.gsum>summary::-webkit-details-marker{display:none}
details.gsum>summary .ghead::after{content:"›";margin-left:6px;color:var(--muted);transition:transform .15s}
details.gsum[open]>summary .ghead::after{transform:rotate(90deg)}
.dayhead{font-size:12px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);margin:4px 0}
.tag{font-size:11px;color:var(--muted);font-family:var(--mono)}
html{scroll-behavior:smooth}
.panel{scroll-margin-top:80px}
.panel.fold{padding:0}
.fold>.fhead{all:unset;box-sizing:border-box;display:flex;width:100%;align-items:center;justify-content:space-between;gap:10px;padding:14px 16px;cursor:pointer}
.fold>.fhead:focus-visible{outline:2px solid var(--accent);outline-offset:-2px;border-radius:8px}
.fold>.fhead h3{margin:0;font-size:17px}
.fold>.fhead .fsum{display:block;font-size:12.5px;color:var(--muted);margin-top:3px;font-family:var(--body);text-transform:none;letter-spacing:0;font-weight:400}
.fold>.fhead .fsum b{color:var(--fg);font-weight:600}
.fold>.fhead .chev{flex:none;width:28px;height:28px;border-radius:50%;display:grid;place-items:center;background:var(--raised);color:var(--muted);transition:transform .15s}
.fold.open>.fhead .chev{transform:rotate(180deg)}
.fold>.fbody{padding:0 16px 16px}
.fold:not(.open)>.fbody{display:none}
.fold>.fbody>.fsub{font-size:12px;color:var(--muted);margin:-4px 0 8px}
.gtabs{display:flex;gap:6px;flex-wrap:wrap;margin:2px 0 10px}
.gtabs button{font:inherit;font-weight:600;font-size:13px;border:1px solid var(--line);background:var(--surface);color:var(--muted);border-radius:999px;padding:5px 12px;cursor:pointer}
.gtabs button[aria-selected="true"]{background:var(--fg);color:var(--bg);border-color:var(--fg)}
.gtabs button .n{font-family:var(--mono);font-weight:500;opacity:.75;margin-left:4px}
.gpane[hidden]{display:none}
.gpane>.pnote{font-size:12px;color:var(--muted);margin:0 0 6px}
.quick{display:flex;flex-wrap:wrap;gap:8px;margin:4px 0 18px}
.quick a{font:inherit;font-weight:600;border:1px solid var(--line);background:var(--surface);color:var(--fg);border-radius:999px;padding:7px 14px;text-decoration:none}
.quick a:hover{border-color:var(--accent)}
</style>
<header class="top">
  <div class="topin">
    <div class="brand">Over<span>lay</span></div>
    <nav class="sport" aria-label="Sport"><a href="./" aria-current="page">Today</a><a href="nfl.html">NFL</a><a href="nba.html">NBA</a><a href="cfb.html">CFB</a></nav>
    <div class="week" id="weeklabel"></div>
  </div>
</header>

<main class="wrap">
  <h2 id="ttitle">Today</h2>
  <p class="lede" id="tlede"></p>
  <div class="quick"><a href="nfl.html?tab=pickem">Pick'em</a><a href="nfl.html?tab=fantasy">Fantasy</a><a href="#" id="openall">Open all</a></div>
  <div class="tgrid">
    <div class="tsec">
      <div class="panel" id="nflpicks"></div>
      <div class="panel" id="nbapicks"></div>
      <div class="panel" id="nhlpicks"></div>
      <div class="panel" id="games"><h3>Games today <span class="sub">Win chance from DraftKings · tap a game for details</span></h3>
        <div class="gtabs" role="tablist" aria-label="Sport"></div>
        <div class="gpane" id="nbagames" data-sport="NBA"></div><div class="gpane" id="nhlgames" data-sport="NHL"></div><div class="gpane" id="cfbgames" data-sport="CFB"></div><div class="gpane" id="cbbgames" data-sport="CBB"></div></div>
    </div>
    <div class="tsec">
      <div class="panel" id="record"></div>
      <div class="panel" id="mybets"></div>
      <div class="panel" id="news"></div>
    </div>
  </div>
</main>
<footer class="wrap" style="padding-block:24px 32px"><p class="note"><span id="updated"></span> <span id="credits"></span> Data: nflverse, sportsdataverse, ESPN (scores, box scores, DraftKings lines for NBA, NHL and college), The Odds API (NFL props only). For entertainment and research only. Bet responsibly.</p></footer>
<div class="toast" id="toast" hidden></div>

<script id="data" type="application/json">__DATA__</script>
<script>
const D=JSON.parse(document.getElementById("data").textContent);
const $=s=>document.querySelector(s);
const esc=t=>String(t??"").replace(/[&<>"]/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c]));
const norm=s=>String(s||"").toLowerCase().replace(/ jr| sr| iii| ii/g,"").replace(/[^a-z]/g,"");
const fmtOdds=o=>o==null?"–":(o>0?"+"+o:String(o));
const dec=o=>o<0?1+100/(-o):1+o/100;
const pct=x=>x==null?"–":Math.round(x*100)+"%";
function toast(t){const el=$("#toast");el.textContent=t;el.hidden=false;clearTimeout(toast.t);toast.t=setTimeout(()=>el.hidden=true,1800);}
const ESPNNFL={LA:"lar",WAS:"wsh"};
const logo=(sport,t,s=20)=>t?`<img class="logo" src="https://a.espncdn.com/i/teamlogos/${sport}/500/${sport==="nfl"?(ESPNNFL[t]||t.toLowerCase()):t.toLowerCase()}.png" alt="" width="${s}" height="${s}" loading="lazy" onerror="this.remove()">`:"";
const logo2=t=>t&&t.logo?`<img class="logo" src="${esc(t.logo)}" alt="" width="20" height="20" loading="lazy" onerror="this.remove()">`:"";
const hs=p=>p&&p.img?`<img class="hs" src="${esc(p.img)}" alt="" loading="lazy" onerror="this.remove()">`:"";
const when=iso=>new Date(iso).toLocaleString("en-US",{weekday:"short",hour:"numeric",minute:"2-digit"});
const ago=iso=>{const m=(Date.now()-new Date(iso))/6e4;return m<60?`${Math.max(1,Math.round(m))} min ago`:m<1440?`${Math.round(m/60)} hr ago`:`${Math.round(m/1440)} d ago`;};

// ---------- header ----------
const todayPT=new Date().toLocaleDateString("en-CA",{timeZone:"America/Los_Angeles"});
const nbaToday=D.nbaGames.filter(g=>g.day===todayPT);
$("#weeklabel").textContent=new Date().toLocaleDateString("en-US",{weekday:"short",month:"short",day:"numeric"}).toUpperCase();
$("#ttitle").textContent=new Date().toLocaleDateString("en-US",{weekday:"long",month:"long",day:"numeric"});
const nextNfl=D.nflGames.filter(g=>new Date(g.kickoff)>new Date()).sort((a,b)=>new Date(a.kickoff)-new Date(b.kickoff))[0];
{const cnt=[["NBA",nbaToday.length],["NHL",(D.nhlGames||[]).filter(g=>g.day===todayPT).length],["college football",(D.cfbGames||[]).filter(g=>g.day===todayPT&&(g.home.rank||g.away.rank)).length,"Top 25 "],["college basketball",(D.cbbGames||[]).filter(g=>g.day===todayPT&&(g.home.rank||g.away.rank)).length,"Top 25 "]].filter(x=>x[1]);
  $("#tlede").textContent=(cnt.length?"Today: "+cnt.map(([k,n,pre])=>`${n} ${pre||""}${k}`).join(", ")+". ":"")+(nextNfl?`Next NFL game: ${nextNfl.away} @ ${nextNfl.home}, ${when(nextNfl.kickoff)}.`:"");}
$("#updated").textContent="Updated "+new Date(D.generated).toLocaleString("en-US",{weekday:"short",month:"short",day:"numeric",hour:"numeric",minute:"2-digit"})+".";
if(D.credits!=null)$("#credits").textContent=`Odds credits left: ${D.credits}.`;

// ---------- one pick row, same look for NFL and NBA ----------
const dayPT=iso=>new Date(iso).toLocaleDateString("en-CA",{timeZone:"America/Los_Angeles"});
const SHORTSTAT={"Shots on Goal":"Shots","Blocked Shots":"Blocks","Pts+Reb+Ast":"PRA","Rush+Rec Yds":"Rush+Rec"};
function pickRow(x,href,meta,second){const done=x.result&&x.result!=="void";
  return `<a class="pickrow" href="${href}"><div class="who">${hs(x)}<div><div class="pname plink">${esc(x.name)}</div><div class="sub">${meta}</div><div class="pickline"><span class="pick ${x.side==="More"?"more":"less"}">${x.side}</span><b>${x.line} ${esc(SHORTSTAT[x.stat]||x.stat)}</b>${x.odds!=null?` <span class="tag">${fmtOdds(x.odds)}</span>`:""}</div></div></div>
    <div class="r stack">${x.result?`<span class="res ${x.result}">${x.result}</span>${x.actual!=null?`<span class="tag">had ${x.actual}</span>`:""}`:`<span class="edge big ${x.chance>=.542?"hot":"cold"}">${pct(x.chance)}</span>${second?`<span class="tag">${second}</span>`:""}`}</div></a>`;}

// ---------- Overlay's NFL prop picks (tracked) ----------
(function(){const G=(D.nflPicks||[]).filter(g=>g.picks.length||(g.close||[]).length);let h=`<h3>Overlay's NFL prop picks <span class="sub">The 3 best-rated props in each game · Week ${D.nflWeek} · tracked in the record</span></h3>`;
  const days=[...new Set(G.map(g=>dayPT(g.kickoff)))].sort();const dd=days.includes(todayPT)?todayPT:days.find(d=>d>todayPT);const S=G.filter(g=>dayPT(g.kickoff)===dd);
  if(!S.length){h+=`<p class="sub">${D.nflLinesAt?"No props cleared the 54% break-even for the next games yet.":"Picks show up after the Thursday and Saturday morning line pulls."} <a href="nfl.html?tab=match" style="color:var(--accent)">All NFL props ›</a></p>`;$("#nflpicks").innerHTML=h;return;}
  const label=dd===todayPT?"Today":new Date(dd+"T12:00").toLocaleDateString("en-US",{weekday:"long",month:"short",day:"numeric"});
  h+=`<div class="dayhead">${label} · ${S.length} game${S.length>1?"s":""}</div>`;
  h+=S.map((g,k)=>{const head=`<div class="ghead"><span>${logo("nfl",g.away)} ${g.away} @ ${logo("nfl",g.home)} ${g.home}</span><span class="sub">${g.wx?`<span style="color:var(--warn)">${esc(g.wx)}</span> · `:""}${new Date(g.kickoff).toLocaleTimeString("en-US",{hour:"numeric",minute:"2-digit"})}</span></div>`;
    const rows=g.picks.map(x=>pickRow(x,`nfl.html?open=${encodeURIComponent(norm(x.name)+"|"+x.stat)}`,`${x.pos?x.pos+" · ":""}${x.team} ${x.team===g.home?"vs":"@"} ${x.opp}`,"")).join("")
      +((g.close||[]).length?`<div class="sub" style="margin:8px 0 0">${g.picks.length?"Next closest (under 54%, not tracked)":"Nothing cleared 54% here. Closest (not tracked)"}:</div>`+g.close.map(x=>pickRow(x,`nfl.html?open=${encodeURIComponent(norm(x.name)+"|"+x.stat)}`,`${x.pos?x.pos+" · ":""}${x.team} ${x.team===g.home?"vs":"@"} ${x.opp}`,"")).join(""):"");
    return S.length>3?`<details class="gsum"${k<2?" open":""}><summary>${head}</summary>${rows}</details>`:head+rows;}).join("");
  if(S.length===1){const g=S[0];const all=[...g.picks,...(g.close||[])];const best=[g.away,g.home].map(t=>all.filter(x=>x.team===t).sort((a,b)=>b.chance-a.chance)[0]).filter(Boolean);
    if(best.length===2)h+=`<div class="panel" style="margin-top:12px;background:var(--raised);border-color:var(--accent)"><div class="dayhead" style="color:var(--accent)">Best 2-pick for this game</div>
      ${best.map(x=>`<div style="display:flex;justify-content:space-between;align-items:center;gap:8px;padding:6px 0"><div><b>${esc(x.name)}</b> <span class="tag">${x.team}</span><div class="pickline" style="margin-top:2px"><span class="pick ${x.side==="More"?"more":"less"}">${x.side}</span><b>${x.line} ${esc(x.stat)}</b></div></div><span class="edge ${x.chance>=.542?"hot":"cold"}">${pct(x.chance)}</span></div>`).join("")}
      ${(()=>{const both=best[0].chance*best[1].chance;return `<p class="sub" style="margin:6px 0 0">PrizePicks needs players from two different teams, so this is the top-rated prop on each side. Both hit about <b>${pct(both)}</b> of the time. A 2-pick Power play pays 3x, so it needs about 33%${both<1/3?": the books make this a slight loser, so keep it small or skip it.":", and this clears it."}</p>`;})()}</div>`;}
  const more=G.filter(g=>dayPT(g.kickoff)>dd).length;
  h+=`<p class="sub" style="margin-top:8px">% = sportsbooks' consensus chance to hit at the PrizePicks line. Lines as of ${D.nflLinesAt?when(D.nflLinesAt):"–"}.${more?` ${more} more game${more>1?"s":""} later this week.`:""} <a href="nfl.html?tab=match" style="color:var(--accent)">All NFL props ›</a></p>`;
  $("#nflpicks").innerHTML=h;})();

// ---------- NBA games + leans ----------
(function(){const G=D.nbaGames.filter(g=>g.day===todayPT||!nbaToday.length);let h=`<h3>NBA games ${nbaToday.length?"today":"next up"} <span class="sub">Win chance from DraftKings, plus Overlay's spread and total leans</span></h3>`;
  if(!G.length){$("#nbagames").innerHTML=h+'<p class="sub">No games scheduled.</p>';return;}
  h+=G.map(g=>{const live=g.state==="in",fin=g.state==="post";const o=g.odds||{};
    const leans=(g.leans||[]).map(l=>`<span class="leanchip" title="Overlay's rough number is ${l.by} points off the line">Lean ${l.type==="spread"?`${l.team} ${l.line>0?"+":""}${l.line}`:`${l.side} ${l.line}`}</span>`).join(" ");
    return `<a class="pickrow" href="nba.html?game=${g.id}"><div><div class="pname">${logo("nba",g.away)} ${g.away} @ ${logo("nba",g.home)} ${g.home}</div><div class="sub">${fin||live?esc(g.detail):when(g.start)}${o.spreadH!=null?` · ${o.spreadH<0?g.home+" "+o.spreadH:g.away+" -"+o.spreadH} · O/U ${o.total}`:" · lines not posted yet"}</div>${leans?`<div style="margin-top:4px">${leans}</div>`:""}</div>
      <div class="r">${fin||live?`<span class="big2">${g.scoreA}-${g.scoreH}</span>`:g.pH!=null?`<span class="sub">${g.pH>=.5?g.home:g.away}</span><span class="big2">${pct(Math.max(g.pH,1-g.pH))}</span>`:""}</div></a>`;}).join("")
    +`<p class="sub" style="margin-top:6px">Leans show up only when Overlay's rough score is 3+ points off the spread or 5+ off the total. They're tracked below so you can see whether they hold up.</p>`;
  $("#nbagames").innerHTML=h;})();

// ---------- Overlay's NBA prop picks (tracked) ----------
(function(){const A=D.nbaPicks||[];const days=[...new Set(A.map(x=>x.day))].sort();const dd=days.includes(todayPT)?todayPT:days.find(d=>d>todayPT);const L=A.filter(x=>x.day===dd).sort((a,b)=>a.kickoff.localeCompare(b.kickoff)||b.chance-a.chance);
  let h=`<h3>Overlay's NBA prop picks <span class="sub">Where our projection disagrees most with DraftKings · up to 8 a day · tracked in the record</span></h3>`;
  if(L.length)h+=`<div class="dayhead">${dd===todayPT?"Today":new Date(dd+"T12:00").toLocaleDateString("en-US",{weekday:"long",month:"short",day:"numeric"})}</div>`;
  h+=L.length?L.map(x=>pickRow(x,`nba.html?open=${encodeURIComponent(x.id+"|"+x.stat)}`,`${x.team} ${x.team===x.home?"vs":"@"} ${x.opp} · ${new Date(x.kickoff).toLocaleTimeString("en-US",{hour:"numeric",minute:"2-digit"})}`,`DK ${pct(x.mkt)}`)).join("")
    +`<p class="sub" style="margin-top:8px">Big % = Overlay's chance. DK = DraftKings' chance after the vig. Overlay has been overconfident so far, so lean on the record below before trusting these.</p>`
    :'<p class="sub">No picks yet today. They show up once DraftKings posts player lines, usually by the morning refresh.</p>';
  $("#nbapicks").innerHTML=h;})();

// ---------- college football (Top 25 games + any leans) ----------
(function(){const A=(D.cfbGames||[]);const days=[...new Set(A.map(g=>g.day))].sort();const dd=days.includes(todayPT)?todayPT:days.find(d=>d>todayPT);
  const el=$("#cfbgames");if(!dd){el.innerHTML="";return;}
  const G=A.filter(g=>g.day===dd&&(g.home.rank||g.away.rank)).sort((a,b)=>a.start.localeCompare(b.start));const leanG=A.filter(g=>g.day===dd&&g.leans&&g.leans.length&&g.state==="pre");
  const tn=t=>`${t.rank?`<span class="tag">${t.rank}</span> `:""}${esc(t.abbr)}`;
  let h=`<h3>College football ${dd===todayPT?"today":new Date(dd+"T12:00").toLocaleDateString("en-US",{weekday:"long"})} <span class="sub">Top 25 games · win chance from DraftKings</span></h3>`;
  h+=G.map(g=>{const o=g.odds||{},fin=g.state==="post",live=g.state==="in";
    return `<a class="pickrow" href="cfb.html?game=${g.id}"><div class="who"><div><div class="pname">${logo2(g.away)} ${tn(g.away)} ${g.neutral?"vs":"@"} ${logo2(g.home)} ${tn(g.home)}</div><div class="sub">${fin||live?esc(g.detail):new Date(g.start).toLocaleTimeString("en-US",{hour:"numeric",minute:"2-digit"})}${g.tv?` · ${esc(g.tv)}`:""}${o.spreadH!=null?` · ${o.spreadH<=0?g.home.abbr+" "+(o.spreadH||"PK"):g.away.abbr+" -"+o.spreadH} · O/U ${o.total}`:""}</div>${(g.leans||[]).length&&!fin?`<div style="margin-top:4px">${g.leans.map(l=>`<span class="leanchip">Lean ${l.type==="spread"?`${l.team} ${l.line>0?"+":""}${l.line}`:`${l.side} ${l.line}`}</span>`).join(" ")}</div>`:""}</div></div>
      <div class="r stack">${fin||live?`<span class="big2">${g.scoreA}-${g.scoreH}</span>`:g.pH!=null?`<span class="big2">${Math.max(g.pH,1-g.pH)>.99?">99%":pct(Math.max(g.pH,1-g.pH))}</span><span class="tag">${g.pH>=.5?g.home.abbr:g.away.abbr}</span>`:""}</div></a>`;}).join("")||'<p class="sub">No ranked teams playing.</p>';
  const other=leanG.filter(g=>!g.home.rank&&!g.away.rank).length;
  h+=`<p class="sub" style="margin-top:8px">${other?`Overlay has leans in ${other} unranked game${other>1?"s":""} too. `:""}Leans come from a scores-only rating that tested about 50/50 against the spread, so they're tracked, not trusted. <a href="cfb.html" style="color:var(--accent)">All games ›</a></p>`;
  el.innerHTML=h;})();

// ---------- Overlay's NHL prop picks (tracked) ----------
(function(){const A=D.nhlPicks||[];const days=[...new Set(A.map(x=>x.day))].sort();const dd=days.includes(todayPT)?todayPT:days.find(d=>d>todayPT);const L=A.filter(x=>x.day===dd).sort((a,b)=>a.kickoff.localeCompare(b.kickoff)||b.chance-a.chance);
  let h=`<h3>Overlay's NHL prop picks <span class="sub">Shots, points and assists where our projection disagrees most with DraftKings · up to 8 a day · tracked in the record</span></h3>`;
  if(L.length)h+=`<div class="dayhead">${dd===todayPT?"Today":new Date(dd+"T12:00").toLocaleDateString("en-US",{weekday:"long",month:"short",day:"numeric"})}</div>`;
  h+=L.length?L.map(x=>pickRow(x,`nhl.html?open=${encodeURIComponent(x.id+"|"+x.stat)}`,`${x.team} ${x.team===x.home?"vs":"@"} ${x.opp} · ${new Date(x.kickoff).toLocaleTimeString("en-US",{hour:"numeric",minute:"2-digit"})}`,`DK ${pct(x.mkt)}`)).join("")
    +`<p class="sub" style="margin-top:8px">Big % = Overlay's chance from his rate per 60 minutes, ice time and the matchup. DK = DraftKings' chance after the vig. New this week, so there's no record yet to judge it by.</p>`
    :'<p class="sub">No picks yet today. They show up once DraftKings posts player lines, usually by the morning refresh.</p>';
  $("#nhlpicks").innerHTML=h;})();

// ---------- NHL + college basketball game lists (panes inside "Games today") ----------
(function(){const G=(D.nhlGames||[]).filter(g=>g.day===todayPT);const el=$("#nhlgames");
  el.innerHTML=G.length?G.map(g=>{const o=g.odds||{},fin=g.state==="post",live=g.state==="in";
    return `<a class="pickrow" href="nhl.html?game=${g.id}"><div><div class="pname">${logo("nhl",g.away)} ${g.away} @ ${logo("nhl",g.home)} ${g.home}</div><div class="sub">${fin||live?esc(g.detail):when(g.start)}${o.total!=null?` · O/U ${o.total}`:""} · ${esc(g.recA)} vs ${esc(g.recH)}</div></div>
      <div class="r stack">${fin||live?`<span class="big2">${g.scoreA}-${g.scoreH}</span>`:g.pH!=null?`<span class="big2">${pct(Math.max(g.pH,1-g.pH))}</span><span class="tag">${g.pH>=.5?g.home:g.away}</span>`:""}</div></a>`;}).join(""):"";})();
(function(){const A=D.cbbGames||[];const G=A.filter(g=>g.day===todayPT&&(g.home.rank||g.away.rank)).sort((a,b)=>a.start.localeCompare(b.start));const el=$("#cbbgames");
  const tn=t=>`${t.rank?`<span class="tag">${t.rank}</span> `:""}${esc(t.abbr)}`;
  el.innerHTML=G.length?`<p class="pnote">Top 25 games.${D.cbbReady?"":" Overlay's ratings switch on in December, once teams have played enough games."}</p>`+G.map(g=>{const o=g.odds||{},fin=g.state==="post",live=g.state==="in";
    return `<a class="pickrow" href="cbb.html?game=${g.id}"><div><div class="pname">${logo2(g.away)} ${tn(g.away)} ${g.neutral?"vs":"@"} ${logo2(g.home)} ${tn(g.home)}</div><div class="sub">${fin||live?esc(g.detail):when(g.start)}${o.spreadH!=null?` · ${o.spreadH<=0?g.home.abbr+" "+(o.spreadH||"PK"):g.away.abbr+" -"+o.spreadH}`:""}</div></div>
      <div class="r stack">${fin||live?`<span class="big2">${g.scoreA}-${g.scoreH}</span>`:g.pH!=null?`<span class="big2">${Math.max(g.pH,1-g.pH)>.99?">99%":pct(Math.max(g.pH,1-g.pH))}</span><span class="tag">${g.pH>=.5?g.home.abbr:g.away.abbr}</span>`:""}</div></a>`;}).join(""):"";})();
// turn the four panes into one tabbed section: each pane's own heading becomes a short note
(function(){const panes=[...document.querySelectorAll("#games .gpane")];
  panes.forEach(p=>{const h=p.querySelector("h3");if(h){const sub=h.querySelector(".sub");h.replaceWith(Object.assign(document.createElement("p"),{className:"pnote",innerHTML:sub?sub.innerHTML:""}));}});
  const count=p=>p.querySelectorAll("a.pickrow").length;const live=panes.filter(p=>count(p));panes.filter(p=>!count(p)).forEach(p=>p.remove());
  const tabs=$("#games .gtabs");if(!live.length){tabs.insertAdjacentHTML("afterend",'<p class="sub">No games today.</p>');tabs.remove();return;}
  let pick=null;try{pick=localStorage.getItem("overlay-today-gtab");}catch(e){}if(!live.some(p=>p.dataset.sport===pick))pick=live[0].dataset.sport;
  tabs.innerHTML=live.map(p=>`<button role="tab" data-s="${p.dataset.sport}" aria-selected="${p.dataset.sport===pick}">${p.dataset.sport}<span class="n">${count(p)}</span></button>`).join("");
  const show=s=>{live.forEach(p=>p.hidden=p.dataset.sport!==s);tabs.querySelectorAll("button").forEach(b=>b.setAttribute("aria-selected",b.dataset.s===s));try{localStorage.setItem("overlay-today-gtab",s);}catch(e){}};
  tabs.onclick=e=>{const b=e.target.closest("button");if(b)show(b.dataset.s);};show(pick);})();

// ---------- injury news ----------
(function(){const n=D.injuryNews||{nfl:[],nba:[]};const items=[...n.nfl.map(x=>({...x,sp:"nfl"})),...n.nba.map(x=>({...x,sp:"nba"}))].sort((a,b)=>new Date(b.at)-new Date(a.at)).slice(0,10);
  let h='<h3>Injury news <span class="sub">Status changes since earlier refreshes</span></h3>';
  h+=items.length?items.map(x=>`<div class="newsrow">${logo(x.sp,x.team,18)} <b>${esc(x.name)}</b> <span class="sub">(${x.team})</span>: ${esc(x.was)} → <b>${esc(x.status)}</b> <span class="sub">· ${ago(x.at)}</span></div>`).join(""):'<p class="sub">No status changes yet. This fills in as the daily refreshes spot new reports.</p>';
  const out=D.nbaInjuries||[];if(out.length)h+=`<details class="recent"><summary>NBA players out or questionable (${Math.min(out.length,8)}) ›</summary>`+out.slice(0,8).map(x=>`<div class="newsrow">${logo("nba",x.team,18)} <b>${esc(x.name)}</b> <span class="sub">(${x.team}, ${x.pts} pts, ${x.min} min)</span>: <b>${esc(x.status)}</b>${x.note?`<div class="sub">${esc(x.note)}</div>`:""}</div>`).join("")+"</details>";
  $("#news").innerHTML=h;})();

// ---------- my bets (saved on this device, graded from results) ----------
let BETS=[];try{BETS=JSON.parse(localStorage.getItem("overlay-bets")||"[]");}catch(e){}
function saveBets(){try{localStorage.setItem("overlay-bets",JSON.stringify(BETS));}catch(e){}}
const R=D.results||{};
function gradeLeg(l,sport,kind){
  if(kind==="parlay"){const gm=(sport==="nba"?R.nbaGames:R.nflGames)||{};const f=gm[l.game];if(!f)return null;const [aw,hm,sa,sh]=f;
    if(l.type==="ml"){if(sa===sh)return"push";return(l.side==="H")===(sh>sa)?"win":"loss";}
    if(l.type==="spread"){const m=(l.side==="H"?sh-sa:sa-sh)+l.line;return m===0?"push":m>0?"win":"loss";}
    const x=(sa+sh-l.line)*(l.side==="Over"?1:-1);return x===0?"push":x>0?"win":"loss";}
  const key=norm(l.name)+"|"+l.stat;
  if(sport==="nfl"){const fin=(R.nflGames||{})[l.game];if(!fin)return null;const e=((R.nfl||{})[key]||[]).find(x=>x[0]===l.week);if(!e)return"void";const v=e[1];l.actual=v;return v===l.line?"push":(v>l.line)===(l.side==="More")?"win":"loss";}
  const fin=(R.nbaGames||{})[String(l.game)];if(!fin)return null;const e=((R.nba||{})[key]||[]).find(x=>String(x[2])===String(l.game));if(!e)return"void";const v=e[1];l.actual=v;return v===l.line?"push":(v>l.line)===(l.side==="More")?"win":"loss";}
function gradeBet(b){if(b.result)return;let pending=false;
  for(const l of b.legs){if(l.res)continue;const r=gradeLeg(l,l.sport||b.sport,b.kind);if(r)l.res=r;else pending=true;}
  if(b.legs.some(l=>l.res==="loss")){b.result="loss";b.ret=0;return;}
  if(pending)return;
  const live=b.legs.filter(l=>l.res==="win");if(!live.length){b.result="void";b.ret=b.stake;return;}
  if(b.kind==="parlay"){b.result="win";b.ret=b.stake*live.reduce((s,l)=>s*dec(l.odds),1);}
  else{const POWER={2:3,3:5,4:10,5:20,6:37.5};const m=live.length===b.legs.length?(b.mult||POWER[live.length]):POWER[live.length]||1;b.result="win";b.ret=b.stake*m;}}
BETS.forEach(gradeBet);saveBets();
function renderBets(){let h='<h3 id="mybets-h">My bets <span class="sub">Saved on this device, graded automatically</span></h3>';
  if(!BETS.length){h+='<p class="sub">Nothing saved yet. On the NFL or NBA Slip tab, tap <b>Save to My bets</b> after you place a slip or parlay. Overlay grades it after the games.</p>';$("#mybets").innerHTML=h;return;}
  const done=BETS.filter(b=>b.result&&b.result!=="void");const w=done.filter(b=>b.result==="win").length;const staked=done.reduce((s,b)=>s+(+b.stake||0),0),ret=done.reduce((s,b)=>s+(b.ret||0),0);
  h+=`<div class="rec"><div><span>Record</span><b>${w}-${done.length-w}</b></div><div><span>Staked</span><b>$${staked.toFixed(0)}</b></div><div><span>Profit</span><b style="color:${ret-staked>=0?"var(--pos)":"var(--neg)"}">${ret-staked>=0?"+":"−"}$${Math.abs(ret-staked).toFixed(0)}</b></div></div>`;
  h+=BETS.slice().reverse().map(b=>{const st=b.result||"pending";const pay=b.kind==="parlay"?b.stake*b.legs.reduce((s,l)=>s*dec(l.odds),1):b.stake*(b.mult||1);
    return `<div class="bet"><div class="top"><div><b>${b.sport.toUpperCase()} ${b.kind==="parlay"?`${b.legs.length}-leg parlay`:`${b.legs.length}-pick PrizePicks`}</b> <span class="sub">· $${b.stake} to win $${pay.toFixed(0)} · saved ${new Date(b.created).toLocaleDateString("en-US",{month:"short",day:"numeric"})}</span></div>
      <div style="display:flex;gap:6px;align-items:center"><span class="res ${st}">${st}</span><button class="x" data-delbet="${b.id}" aria-label="Delete">✕</button></div></div>
      ${b.legs.map(l=>`<div class="legline"><i class="${l.res||""}">${l.res==="win"?"✓":l.res==="loss"?"✗":l.res?"–":"·"}</i> ${esc(b.kind==="parlay"?`${l.label} (${fmtOdds(l.odds)})`:`${l.name} ${l.side} ${l.line} ${l.stat}`)}${l.actual!=null?` <span>(${l.actual})</span>`:""}</div>`).join("")}</div>`;}).join("");
  h+='<p class="sub" style="margin-top:8px">PrizePicks payouts use the multiplier you set on the Slip tab (Power play). Flex payouts aren\'t graded. Bets live on this phone or computer only.</p>';
  $("#mybets").innerHTML=h;}
renderBets();
document.addEventListener("click",e=>{const d=e.target.closest("[data-delbet]");if(d){BETS=BETS.filter(b=>String(b.id)!==d.dataset.delbet);saveBets();renderBets();toast("Deleted");}});

// ---------- Overlay's own record ----------
(function(){const T=D.track||{};const nf=T.nfl||{},nb=T.nba||{},np=T.nbaProps||{},top=nf.top||{};const rec=s=>s&&s.n?`${s.w}-${s.l}`:"0-0";const p=s=>s&&s.n?pct(s.pct):"–";
  const tiles=(a,b,c)=>`<div class="rec">${[a,b,c].map(([k,v,col])=>`<div><span>${k}</span><b${col?` style="color:${col}"`:""}>${v}</b></div>`).join("")}</div>`;
  const tone=(s,be)=>s&&s.n>=10?(s.pct>=be?"var(--pos)":"var(--neg)"):"";
  const mark=x=>`<i class="${x.result}">${x.result==="win"?"✓":x.result==="loss"?"✗":"–"}</i>`;
  const clvTxt=c=>c&&c.n?`<p class="sub" style="margin:2px 0 0" title="How the line moved between when Overlay picked it and the start. Getting better numbers than the final line is the earliest sign a system works.">Line moved <b style="color:var(--pos)">our way on ${c.toward}</b>, against us on ${c.away}, no change on ${c.same} (${c.n} graded picks).</p>`:"";
  let h=`<h3 id="record-h">Overlay's track record <span class="sub">Every pick is logged before the game starts and graded after</span></h3>`;
  h+=`<div class="sec">NFL player props · Overlay's picks (best 3 per game)</div>`+tiles(["Record",rec(top)],["Hit rate",p(top),tone(top,.542)],["Pending",top.pending||0]);
  h+=clvTxt(top.clv);
  if(top.byWeek)h+=`<p class="sub">${Object.entries(top.byWeek).filter(([,s])=>s.n).map(([w,s])=>`Wk ${w}: ${s.w}-${s.l}`).join(" · ")} · Needs 54%+ to profit on a 6-pick Flex.</p>`;
  h+=`<details class="recent"><summary>All NFL props rated 54%+: ${rec(nf)} (${p(nf)}) ›</summary><div style="overflow-x:auto"><table class="mini"><thead><tr><th>Rated</th><th>Picks</th><th>Expected</th><th>Actual</th></tr></thead><tbody>${(nf.buckets||[]).map(b=>`<tr><td>${b.label}</td><td>${b.n}</td><td>${b.exp!=null?pct(b.exp):"–"}</td><td>${b.n?pct(b.pct):"–"}</td></tr>`).join("")}</tbody></table></div><p class="sub">${Object.entries(nf.byWeek||{}).map(([w,s])=>`Wk ${w}: ${s.w}-${s.l}`).join(" · ")}</p></details>`;
  h+=`<div class="sec">NBA player props · Overlay's picks vs the DraftKings line</div>`+tiles(["Record",rec(np)],["Hit rate",p(np),tone(np,.524)],["Pending",np.pending||0]);
  h+=clvTxt(np.clv);
  h+=`<p class="sub">${np.n?`Overlay expected ${pct(np.ours)}; DraftKings' odds implied ${pct(np.mkt)}. Beating the DraftKings number is the real test. `:"Started Nov 4, so there's nothing graded yet. "}${np.byStat&&np.n?Object.entries(np.byStat).filter(([,s])=>s.n).map(([k,s])=>`${k}: ${s.w}-${s.l}`).join(" · "):""}</p>`;
  const hp=T.nhlProps||{};h+=`<div class="sec">NHL player props · Overlay's picks vs the DraftKings line</div>`+tiles(["Record",rec(hp)],["Hit rate",p(hp),tone(hp,.524)],["Pending",hp.pending||0]);
  h+=clvTxt(hp.clv);
  if(hp.n)h+=`<p class="sub">Overlay expected ${pct(hp.ours)}; DraftKings' odds implied ${pct(hp.mkt)}.</p>`;
  h+=`<div class="sec">NBA team leans · rough model vs DraftKings</div>`+tiles(["Spreads",rec(nb.spread),tone(nb.spread,.524)],["Totals",rec(nb.total),tone(nb.total,.524)],["Pending",nb.pending||0]);
  const cf=T.cfb||{};if((cf.spread&&cf.spread.n)||(cf.total&&cf.total.n)||cf.pending)h+=`<div class="sec">College football leans · scores-only model vs DraftKings</div>`+tiles(["Spreads",rec(cf.spread),tone(cf.spread,.524)],["Totals",rec(cf.total),tone(cf.total,.524)],["Pending",cf.pending||0]);
  const cb=T.cbb||{};if((cb.spread&&cb.spread.n)||(cb.total&&cb.total.n)||cb.pending)h+=`<div class="sec">College basketball leans · scores-only model vs DraftKings</div>`+tiles(["Spreads",rec(cb.spread),tone(cb.spread,.524)],["Totals",rec(cb.total),tone(cb.total,.524)],["Pending",cb.pending||0]);
  h+=`<p class="sub">Spreads and totals need 52.4% to profit at -110. Small samples swing a lot, so give any of these a few hundred picks before trusting them. NFL weeks 6–7 were back-filled from the lines the site showed those Saturdays.</p>`;
  const R=T.recent||{};
  const lists=[["NFL props",R.nflProps,x=>`${esc(x.name)} ${x.side} ${x.line} ${esc(x.stat)} <span>(${pct(x.chance)})</span> → <b>${x.actual??"–"}</b>`],
    ["NBA props",R.nbaProps,x=>`${esc(x.name)} ${x.side} ${x.line} ${esc(x.stat)} <span>(${pct(x.chance)})</span> → <b>${x.actual??"–"}</b>`],
    ["NHL props",R.nhlProps,x=>`${esc(x.name)} ${x.side} ${x.line} ${esc(x.stat)} <span>(${pct(x.chance)})</span> → <b>${x.actual??"–"}</b>`],
    ["College basketball leans",R.cbb,x=>`${x.away} @ ${x.home}: ${x.type==="spread"?`${x.team} ${x.line>0?"+":""}${x.line}`:`${x.side} ${x.line}`} → ${esc(x.final||"")}`],
    ["College football leans",R.cfb,x=>`${x.away} @ ${x.home}: ${x.type==="spread"?`${x.team} ${x.line>0?"+":""}${x.line}`:`${x.side} ${x.line}`} → ${esc(x.final||"")}`],
    ["NBA team leans",R.nbaTeams,x=>`${x.away} @ ${x.home}: ${x.type==="spread"?`${x.team} ${x.line>0?"+":""}${x.line}`:`${x.side} ${x.line}`} → ${esc(x.final||"")}`]];
  const dayOf=x=>x.day||(x.week?`Week ${x.week}`:dayPT(x.kickoff));
  const dlabel=d=>/^\d{4}-/.test(d)?new Date(d+"T12:00").toLocaleDateString("en-US",{weekday:"short",month:"short",day:"numeric"}):d;
  for(const [t,L,f] of lists){if(!L||!L.length)continue;const groups=[];L.forEach(x=>{const d=dayOf(x);let g=groups.find(y=>y.d===d);if(!g)groups.push(g={d,xs:[]});g.xs.push(x);});
    h+=`<details class="recent"><summary>Recent ${t} ›</summary>${groups.map(g=>{const w=g.xs.filter(x=>x.result==="win").length,l=g.xs.filter(x=>x.result==="loss").length;
      return `<div class="dayhead" style="margin-top:8px;display:flex;justify-content:space-between"><span>${dlabel(g.d)}</span><span style="color:${w>l?"var(--pos)":w<l?"var(--neg)":"var(--muted)"}">${w}-${l}</span></div>${g.xs.map(x=>`<div class="legline">${mark(x)} ${f(x)}</div>`).join("")}`;}).join("")}</details>`;}
  $("#record").innerHTML=h;})();
// ---------- collapsible sections: closed by default, each with a one-line summary; remembered per device ----------
let OPEN={};try{OPEN=JSON.parse(localStorage.getItem("overlay-today-open")||"{}");}catch(e){}
const saveOpen=()=>{try{localStorage.setItem("overlay-today-open",JSON.stringify(OPEN));}catch(e){}};
const rec2=s=>s&&s.n?`${s.w}-${s.l}`:"0-0";
function summaryFor(id){const T=D.track||{};
  if(id==="nflpicks"){const G=(D.nflPicks||[]).filter(g=>g.picks.length||(g.close||[]).length);const days=[...new Set(G.map(g=>dayPT(g.kickoff)))].sort();const dd=days.includes(todayPT)?todayPT:days.find(d=>d>todayPT);
    const S=G.filter(g=>dayPT(g.kickoff)===dd);const n=S.reduce((a,g)=>a+g.picks.length,0);const wk=(T.nfl&&T.nfl.top&&T.nfl.top.byWeek||{})[D.nflWeek];
    if(!S.length)return D.nflLinesAt?"No picks above 54% for the next games":"Picks arrive with the Thursday and Saturday line pulls";
    return `<b>${n} pick${n!==1?"s":""}</b> ${dd===todayPT?"today":"for "+new Date(dd+"T12:00").toLocaleDateString("en-US",{weekday:"long"})} · ${S.length} game${S.length>1?"s":""}${wk&&wk.n?` · Week ${D.nflWeek} so far ${wk.w}-${wk.l}`:""}`;}
  if(id==="nbapicks"){const A=D.nbaPicks||[];const t=A.filter(x=>x.day===todayPT);const y=((T.recent||{}).nbaProps||[]).filter(x=>x.day&&x.day<todayPT);const yd=y.length?y[0].day:null;const yy=y.filter(x=>x.day===yd);
    const w=yy.filter(x=>x.result==="win").length,l=yy.filter(x=>x.result==="loss").length;
    return `${t.length?`<b>${t.length} pick${t.length>1?"s":""} today</b>`:"No picks yet today"}${yd?` · ${new Date(yd+"T12:00").toLocaleDateString("en-US",{weekday:"short"})} went <b>${w}-${l}</b>`:""}`;}
  if(id==="nhlpicks"){const t=(D.nhlPicks||[]).filter(x=>x.day===todayPT);const s=(T.nhlProps||{});return `${t.length?`<b>${t.length} pick${t.length>1?"s":""} today</b>`:"No picks yet today"}${s.n?` · record <b>${s.w}-${s.l}</b>`:""}`;}
  if(id==="games"){const parts=[...document.querySelectorAll("#games .gtabs button")].map(b=>`${b.dataset.s} <b>${b.querySelector(".n").textContent}</b>`);return parts.length?parts.join(" · "):"No games today";}
  if(id==="cfbgames"){const A=(D.cfbGames||[]).filter(g=>g.day===todayPT);const top=A.filter(g=>g.home.rank||g.away.rank);const live=A.filter(g=>g.state==="in").length;
    return `<b>${top.length} Top 25 game${top.length!==1?"s":""}</b> today${live?` · ${live} live`:""}`;}
  if(id==="nbagames"){const t=D.nbaGames.filter(g=>g.day===todayPT);const le=t.reduce((a,g)=>a+(g.leans||[]).length,0);
    return t.length?`<b>${t.length} game${t.length>1?"s":""}</b> today${le?` · ${le} lean${le>1?"s":""}`:""}`:"No games today";}
  if(id==="record"){const parts=[["NFL props",T.nfl&&T.nfl.top],["NBA props",T.nbaProps],["NHL props",T.nhlProps],["NBA spreads",T.nba&&T.nba.spread],["CFB spreads",T.cfb&&T.cfb.spread],["CBB spreads",T.cbb&&T.cbb.spread]].filter(([,s])=>s&&s.n);
    return parts.map(([k,s])=>`${k} <b>${rec2(s)}</b>`).join(" · ")||"Nothing graded yet";}
  if(id==="mybets"){if(!BETS.length)return "Nothing saved yet";const p=BETS.filter(b=>!b.result).length,d=BETS.filter(b=>b.result&&b.result!=="void"),w=d.filter(b=>b.result==="win").length;
    return `<b>${w}-${d.length-w}</b>${p?` · ${p} pending`:""}`;}
  if(id==="news"){const n=D.injuryNews||{nfl:[],nba:[]};const k=n.nfl.length+n.nba.length;return k?`<b>${k} status change${k>1?"s":""}</b> in the last 3 days`:"No new status changes";}
  return "";}
function fold(id){const el=document.getElementById(id);if(!el||!el.firstElementChild)return;
  const h=el.querySelector("h3");let title=id,sub="";if(h){const sp=h.querySelector(".sub");if(sp){sub=sp.innerHTML;sp.remove();}title=h.innerHTML;h.remove();}
  const body=el.innerHTML;el.classList.add("fold");el.classList.toggle("open",!!OPEN[id]);
  el.innerHTML=`<button class="fhead" aria-expanded="${!!OPEN[id]}"><span><h3>${title}</h3><span class="fsum">${summaryFor(id)}</span></span><span class="chev" aria-hidden="true">▾</span></button><div class="fbody">${sub?`<p class="fsub">${sub}</p>`:""}${body}</div>`;
  el.querySelector(".fhead").onclick=()=>{OPEN[id]=!OPEN[id];saveOpen();el.classList.toggle("open",OPEN[id]);el.querySelector(".fhead").setAttribute("aria-expanded",OPEN[id]);};}
const FOLDS=["nflpicks","nbapicks","nhlpicks","games","record","mybets","news"];
FOLDS.forEach(fold);
const _rb=renderBets;renderBets=function(){_rb();fold("mybets");};
$("#openall").onclick=e=>{e.preventDefault();const all=FOLDS.every(id=>OPEN[id]);FOLDS.forEach(id=>{OPEN[id]=!all;const el=document.getElementById(id);if(el){el.classList.toggle("open",!all);el.querySelector(".fhead")?.setAttribute("aria-expanded",!all);}});saveOpen();$("#openall").textContent=all?"Open all":"Close all";};
$("#openall").textContent=FOLDS.every(id=>OPEN[id])?"Close all":"Open all";
if(location.hash){const id=location.hash.slice(1),el=document.getElementById(id);if(el){if(FOLDS.includes(id)&&!OPEN[id])el.querySelector(".fhead")?.click();el.scrollIntoView();}}
</script>
