
<style>
.banner{background:var(--raised);border:1px solid var(--line);border-radius:8px;padding:10px 14px;font-size:13px;color:var(--muted);margin-bottom:12px;max-width:80ch}
.banner b{color:var(--fg)}
.delta{font-family:var(--mono);font-size:12px}
.delta.up{color:var(--pos)} .delta.dn{color:var(--neg)}
input[type=search],input[type=number]{font:inherit;font-size:14px;color:var(--fg);background:var(--surface);border:1px solid var(--line);border-radius:6px;padding:7px 10px}
input[type=search]{width:190px}
.chk{flex-direction:row!important;align-items:center;gap:6px!important;padding-bottom:8px}
.star{background:none;border:0;cursor:pointer;font-size:18px;line-height:1;color:var(--line);padding:2px 4px}
.star[aria-pressed="true"]{color:var(--accent)}
.badge{display:inline-block;min-width:18px;padding:0 5px;border-radius:9px;background:var(--accent);color:var(--surface);font-family:var(--mono);font-size:11px;line-height:18px;text-align:center;margin-left:4px;vertical-align:2px}
.trend{font-family:var(--mono);font-size:12px;white-space:nowrap}
.trend.up{color:var(--pos)} .trend.dn{color:var(--neg)} .trend.flat{color:var(--muted)}
.btn{font:inherit;font-weight:600;border-radius:6px;padding:8px 14px;cursor:pointer;border:1px solid var(--line);background:var(--raised);color:var(--fg)}
.btn.primary{background:var(--accent);border-color:var(--accent);color:var(--surface)}
.btn:disabled{opacity:.5;cursor:default}
.seg{display:inline-flex;border:1px solid var(--line);border-radius:6px;overflow:hidden}
.seg button{font:inherit;font-weight:600;border:0;background:var(--surface);color:var(--muted);padding:7px 14px;cursor:pointer}
.seg button[aria-pressed="true"].more{background:var(--pos-soft);color:var(--pos)}
.seg button[aria-pressed="true"].less{background:var(--neg-soft);color:var(--neg)}
.checker{background:var(--raised);border-radius:8px;padding:12px;display:flex;flex-direction:column;gap:10px}
.checker .row{display:flex;flex-wrap:wrap;gap:10px;align-items:center}
.checker input[type=number]{width:96px}
.hits{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}
.hits div{background:var(--surface);border-radius:6px;padding:8px}
.hits b{display:block;font-family:var(--mono);font-size:18px}
.hits span{font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:var(--muted)}
.mini{width:100%;border-collapse:collapse;font-variant-numeric:tabular-nums;min-width:0}
.mini th,.mini td{padding:6px 8px;font-size:12px;border-bottom:1px solid var(--line);text-align:right}
.mini th:first-child,.mini td:first-child{text-align:left}
.split{background:var(--raised);border-radius:8px;padding:10px 12px;font-size:13px;margin-bottom:8px}
/* slip */
.slipgrid{display:grid;grid-template-columns:minmax(0,1.6fr) minmax(0,1fr);gap:16px;align-items:start}
@media (max-width:820px){.slipgrid{grid-template-columns:1fr}}
.leg{display:flex;justify-content:space-between;gap:10px;padding:10px 0;border-top:1px solid var(--line);align-items:center}
.leg:first-of-type{border-top:0}
.legr{display:flex;gap:10px;align-items:center;flex-shrink:0}
.x{background:none;border:1px solid var(--line);color:var(--muted);border-radius:6px;cursor:pointer;padding:3px 8px;font:inherit}
.corr{font-size:13px;padding:8px 10px;border-radius:6px;margin-top:6px}
.corr.plus{background:var(--pos-soft)} .corr.minus{background:var(--neg-soft)}
.sum{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin:10px 0}
.sum div{background:var(--raised);border-radius:6px;padding:10px}
.sum b{display:block;font-family:var(--mono);font-size:20px}
.sum span{font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:var(--muted)}
/* heatmap */
.heat td.h{font-family:var(--mono);text-align:center;font-weight:600;min-width:72px}
.heat th.sortable{cursor:pointer}
.heat th.sortable:hover{color:var(--fg)}
.envrow{display:flex;flex-wrap:wrap;gap:6px;margin-top:2px}
.flag{font-size:11px;font-weight:600;padding:2px 7px;border-radius:4px;background:var(--raised);color:var(--muted);border:1px solid var(--line);white-space:nowrap}
.flag.warn{background:var(--warn-soft);color:var(--warn);border-color:transparent}
.toast{position:fixed;left:50%;bottom:calc(20px + env(safe-area-inset-bottom,0px));transform:translateX(-50%);background:var(--fg);color:var(--bg);padding:8px 14px;border-radius:6px;font-weight:600;z-index:40}
.subnav{display:flex;flex-wrap:wrap;gap:6px;margin:4px 0 16px}
.subnav button{font:inherit;font-weight:600;border:1px solid var(--line);background:var(--surface);color:var(--muted);border-radius:999px;padding:7px 14px;cursor:pointer}
.subnav button[aria-pressed="true"]{background:var(--fg);border-color:var(--fg);color:var(--bg)}
.addrow{display:flex;flex-wrap:wrap;gap:8px;align-items:center;margin-bottom:12px}
.addrow input{min-width:0;flex:1 1 220px;max-width:340px}
.slot{font-family:var(--mono);font-size:12px;font-weight:600;color:var(--muted);width:56px}
tr.bench td{opacity:.62}
.cmpgrid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:12px}
.cmpcard{background:var(--surface);border:1px solid var(--line);border-radius:8px;padding:14px;display:flex;flex-direction:column;gap:8px;min-width:0}
.cmpcard.win{border-color:var(--pos);box-shadow:0 0 0 1px var(--pos)}
.big{font-family:var(--mono);font-size:30px;font-weight:600;line-height:1}
.kv{display:flex;justify-content:space-between;gap:8px;font-size:13px;border-top:1px solid var(--line);padding-top:6px}
.kv span:first-child{color:var(--muted)}
.why{font-size:12px;color:var(--muted)}
.reason{font-size:11px;font-weight:600;padding:2px 7px;border-radius:4px;white-space:nowrap;background:var(--pos-soft);color:var(--pos);display:inline-block;margin:1px 2px 1px 0}
/* clickable players */
.plink{color:var(--accent);font-weight:600}
tr.click:hover .plink,.pcard:hover .plink{text-decoration:underline}
td.chev{color:var(--muted);font-size:20px;width:24px;text-align:center;padding-left:0}
tr.click:hover td.chev{color:var(--accent)}
.tip{display:flex;gap:12px;align-items:center;justify-content:space-between;background:var(--accent-soft);border-radius:8px;padding:10px 14px;margin-bottom:12px;font-size:13px}
.tip b{color:var(--fg)}
.tip button{background:none;border:0;color:var(--muted);font:inherit;font-weight:600;cursor:pointer;white-space:nowrap}
/* info toggles */
details.info{margin-top:10px;font-size:12px;color:var(--muted);max-width:80ch}
details.info summary{cursor:pointer;font-weight:600;list-style:none;display:inline-flex;gap:6px;align-items:center}
details.info summary::-webkit-details-marker{display:none}
details.info summary::before{content:"ⓘ";font-size:14px}
details.info p{margin:6px 0 0}
details.inj summary{cursor:pointer;font-size:11px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);margin:18px 0 6px}
.lede{margin-bottom:12px}
/* filters toggle (phones) */
.ftoggle{display:none}
/* phone cards */
.cards{display:none;flex-direction:column;gap:8px}
.pcard{background:var(--surface);border:1px solid var(--line);border-radius:8px;padding:12px;display:flex;flex-direction:column;gap:8px;cursor:pointer;text-align:left;font:inherit;color:inherit;width:100%}
.pcard .top{display:flex;justify-content:space-between;gap:8px;align-items:flex-start}
.pcard .play{display:flex;gap:8px;align-items:center;flex-wrap:wrap}
.pcard .foot{display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap}
.pcard .more-link{color:var(--accent);font-weight:600;font-size:13px;white-space:nowrap}
.bigline{font-family:var(--mono);font-weight:600;font-size:16px}
@media (max-width:700px){
  .brand{font-size:24px}
  .topin{padding-top:8px}
  .week{padding-bottom:2px}
  h2{font-size:22px;margin-top:16px}
  #match .tablebox{display:none}
  .cards{display:flex}
  .ftoggle{display:inline-flex}
  .controls{display:none}
  .controls.open{display:flex}
  nav.tabs{gap:0;padding:0 8px}
  nav.tabs button{font-size:13px;padding:9px 5px 8px;letter-spacing:.01em}
  .sample{display:none}
  .banner{font-size:12px;padding:8px 12px}
}
.mv{font-family:var(--mono);font-size:11px;white-space:nowrap}
.mv.up{color:var(--pos)} .mv.dn{color:var(--neg)} .mv.flat{color:var(--muted)}
table.shop tr.bestline td{background:var(--pos-soft)}
.propchips{display:flex;flex-wrap:wrap;gap:6px;margin-top:6px}
.propchip{font:inherit;font-size:12px;border:1px solid var(--line);background:var(--raised);color:var(--fg);border-radius:6px;padding:5px 8px;cursor:pointer;display:inline-flex;gap:6px;align-items:center}
.propchip:hover{border-color:var(--accent)}
.propchip .pk{font-weight:700;font-size:11px;letter-spacing:.04em}
.propchip .pk.more{color:var(--pos)} .propchip .pk.less{color:var(--neg)}
.gplayers{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:12px;margin-top:12px}
.gprow{padding:10px 0;border-top:1px solid var(--line)}
.gprow:first-of-type{border-top:0}
#gamedetail{scroll-margin-top:110px}
details.ginj summary{cursor:pointer;list-style:none}
details.ginj summary::-webkit-details-marker{display:none}
.bestrow{display:flex;flex-wrap:wrap;gap:8px;align-items:center;margin-bottom:12px}
/* pick'em */
.pkbar{display:flex;flex-wrap:wrap;gap:16px;align-items:end;margin-bottom:14px}
.pkbar label{display:flex;flex-direction:column;gap:4px;font-size:11px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:var(--muted)}
.pkbar input[type=range]{width:220px}
.pksum{display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:8px;margin-bottom:14px}
.pksum div{background:var(--surface);border:1px solid var(--line);border-radius:8px;padding:10px 12px}
.pksum b{display:block;font-family:var(--mono);font-size:22px}
.pksum span{font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:var(--muted)}
.pkgame{background:var(--surface);border:1px solid var(--line);border-radius:8px;padding:10px 12px;display:grid;grid-template-columns:1fr 1fr;gap:8px;position:relative}
.pkgame .meta2{grid-column:1/-1;display:flex;flex-wrap:wrap;gap:6px;justify-content:space-between;align-items:center;font-size:12px;color:var(--muted)}
.pkteam{font:inherit;color:var(--fg);background:var(--raised);border:2px solid transparent;border-radius:8px;padding:10px;cursor:pointer;text-align:left;display:flex;flex-direction:column;gap:6px;min-width:0}
.pkteam[aria-pressed="true"]{border-color:var(--accent);background:var(--accent-soft)}
.pkteam:disabled{cursor:default;opacity:.75}
.pkteam .tn{font-family:var(--display);font-weight:700;font-size:20px;text-transform:uppercase;letter-spacing:.02em;display:flex;justify-content:space-between;gap:6px}
.pkbarw{height:6px;border-radius:3px;background:var(--line);overflow:hidden}
.pkbarw i{display:block;height:100%;background:var(--pos)}
.pkteam .sm{font-size:12px;color:var(--muted)}
.pklist{display:grid;grid-template-columns:repeat(auto-fill,minmax(320px,1fr));gap:10px}
.upset{font-size:11px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;padding:2px 7px;border-radius:4px;background:var(--warn-soft);color:var(--warn)}
.won{color:var(--pos)} .lost{color:var(--neg)}
</style>
<header class="top">
  <div class="topin">
    <div class="brand">Over<span>lay</span></div>
    <div class="week" id="weeklabel"></div>
    <div class="sample" id="freshness"></div>
  </div>
  <nav class="tabs" role="tablist">
    <button role="tab" aria-selected="true" data-tab="match">Props</button>
    <button role="tab" aria-selected="false" data-tab="slip">Slip<span class="badge" id="slipcount" hidden>0</span></button>
    <button role="tab" aria-selected="false" data-tab="fantasy">Fantasy</button>
    <button role="tab" aria-selected="false" data-tab="pickem">Pick'em</button>
    <button role="tab" aria-selected="false" data-tab="defense">Defenses</button>
    <button role="tab" aria-selected="false" data-tab="games">Games</button>
  </nav>
</header>

<main class="wrap">
  <section id="match">
    <h2 id="matchtitle">Props</h2>
    <p class="lede">PrizePicks props ranked by the sportsbooks' chance to hit, with each player's matchup and workload.</p>
    <div class="tip" id="tip" hidden><span><b>Tap any player for the full breakdown:</b> line checker, matchup, usage, injuries and Add to slip.</span><button id="tipclose">Got it</button></div>
    <div class="banner" id="linesbanner"></div>
    <button class="btn ftoggle" id="ftoggle" aria-expanded="false" aria-controls="filters">Filters</button>
    <div class="controls" id="filters">
      <label for="q">Player<input type="search" id="q" placeholder="Search name"></label>
      <label for="pos">Position<select id="pos"><option value="">All</option><option>QB</option><option>RB</option><option>WR</option><option>TE</option></select></label>
      <label for="mkt">Stat<select id="mkt"><option value="">All stats</option></select></label>
      <label for="gm">Game<select id="gm"><option value="">All games</option></select></label>
      <label for="grd">Matchup<select id="grd"><option value="">Any grade</option><option value="AB">Good (A–B)</option><option value="DF">Tough (D–F)</option></select></label>
      <label for="sliptype" id="sliplabel" hidden>Slip type<select id="sliptype"><option value="0.542">6-pick Flex (54.2%)</option><option value="0.543">5-pick Flex (54.3%)</option><option value="0.562">4-pick Power (56.2%)</option><option value="0.577">2-pick Power (57.7%)</option></select></label>
      <label class="chk" for="wonly"><input type="checkbox" id="wonly"> Watchlist only</label>
      <label class="chk" for="moved"><input type="checkbox" id="moved"> Lines that moved</label>
    </div>
    <div class="tablebox"><table><thead id="matchhead"></thead><tbody id="matchbody"></tbody></table></div>
    <div class="cards" id="matchcards"></div>
    <details class="info"><summary>How to read this</summary>
      <p><b>Hit chance</b> is how likely the sportsbooks think the pick is to hit: a blend of up to 7 books (Pinnacle, FanDuel, DraftKings, BetMGM, ESPN Bet, BetRivers, Bovada) with their fee removed, counting the sharpest books most. "Books 73.5" under a line means the sportsbooks' average line is at least a point away from PrizePicks, which is usually where the value is. It's <b>green</b> when it beats what your slip type needs to break even, about 54% for a 6-pick Flex. "adj" means the book's line was a little different from PrizePicks, so Overlay adjusted it.</p>
      <p><b>Our proj</b> is Overlay's own rough estimate from a handful of games. It's a lean, not a price. When it disagrees with the hit chance, trust the hit chance.</p>
      <p><b>▲ / ▼ under a line or hit chance</b> shows how it moved since the previous odds pull (Thursday → Saturday). Lines that move usually follow injury news or sharp money.</p>
      <p><b>Matchup</b> grades how much this defense allows to the position: A allows the most, F the least. Hover or open the player for the numbers.</p>
      <p><b>Usage</b> is the last two games' pass attempts, carries or targets for that stat. ▲ or ▼ means a change of more than 15% from earlier games.</p>
</details>
  </section>

  <section id="slip" hidden>
    <h2>Slip builder</h2>
    <p class="lede">Add picks from any player's breakdown to see your slip's odds and payout.</p>
    <div class="slipgrid">
      <div class="panel" id="sliplegs"></div>
      <div class="panel" id="slipsum"></div>
    </div>
    <details class="info"><summary>How chances are calculated</summary><p>Chances come from sportsbook no-vig prices when books have the prop. Picks marked * use Overlay's rough estimate from this season's game logs and the matchup, treating picks as independent. Correlated picks hit together more often than these numbers say. Payouts vary by state and by pick type, so set the multiplier to what your app shows.</p></details>
  </section>

  <section id="fantasy" hidden>
    <h2 id="ftitle">Fantasy</h2>
    <p class="lede">Half-PPR projections, your best lineup, start/sit and waiver pickups.</p>
    <div class="subnav" id="fnav">
      <button data-fv="team">My team</button><button data-fv="cmp">Start / sit</button><button data-fv="rank">Rankings</button><button data-fv="wire">Waivers</button>
    </div>
    <datalist id="fplayers"></datalist>
    <div id="fview"></div>
    <details class="info"><summary>How projections work</summary><p>Projections are simple estimates: a blend of season and last-3-game half-PPR scoring, nudged by the half-PPR points this defense allows to the position and by the team's implied points. Range is a typical bad week to a typical good week. Players listed Out project to 0.</p><p>Kickers and defenses use Yahoo's default scoring: field goals 3 points (0–39 yds), 4 (40–49), 5 (50+), extra points 1; defense gets 1 per sack, 2 per interception, fumble recovery, safety or blocked kick, 6 per TD, plus points-allowed tiers (+10 shutout down to −4 for 35+). A defense's projection uses its own sacks and takeaways, what the opponent's offense gives up, and the opponent's expected points. For a defense, "Team pts" is the opponent's expected points (lower is better).</p></details>
  </section>

  <section id="pickem" hidden>
    <h2 id="pktitle">Pick'em</h2>
    <p class="lede">Straight-up picks from the betting markets' win chances, tuned to your pool size. Tap a team to change a pick.</p>
    <div id="pkview"></div>
    <details class="info"><summary>How the picks work</summary>
      <p><b>Win chance</b> comes from each game's moneyline with the sportsbook fee removed. Betting markets are the most accurate free predictor of who wins.</p>
      <p><b>Pool size matters.</b> Picking every favorite gets you the most correct picks on average, but in a big pool you'll often tie with many people who did the same. Overlay simulates the week thousands of times against a pool of your size, assuming other players pick favorites a bit more often than the odds justify, and adds an upset only when it raises your chance of finishing first.</p>
      <p><b>Tiebreaker</b> uses the last game's over/under, which is the market's best guess at total points.</p>
      <p>Estimates only. Other players' picks are modeled, not known.</p></details>
  </section>

  <section id="defense" hidden>
    <h2>Defense heatmap</h2>
    <p class="lede">What each defense allows per game. Green = good matchup to attack. Tap a column to sort.</p>
    <div class="tablebox"><table class="heat"><thead id="heathead"></thead><tbody id="heatbody"></tbody></table></div>
  </section>

  <section id="games" hidden>
    <h2>Games &amp; injuries</h2>
    <p class="lede">Tap a game to see every player in it with their props, plus injuries and the game environment.</p>
    <div class="games" id="gamelist"></div>
    <div id="gamedetail"></div>
  </section>
</main>
<footer class="wrap" style="padding-block:0 32px"><p class="note">Data: <a href="https://github.com/nflverse" style="color:var(--accent)">nflverse</a> (stats, snap counts, injuries, schedule and lines). <span id="updated"></span> <span id="credits"></span> For entertainment and research only.</p></footer>

<div class="scrim" id="scrim" hidden></div>
<aside class="sheet" id="sheet" hidden aria-label="Player detail"></aside>
<div class="toast" id="toast" hidden></div>

<script id="data" type="application/json">__DATA__</script>
<script>
const D=JSON.parse(document.getElementById("data").textContent);
const NAMES={ARI:"Arizona",ATL:"Atlanta",BAL:"Baltimore",BUF:"Buffalo",CAR:"Carolina",CHI:"Chicago",CIN:"Cincinnati",CLE:"Cleveland",DAL:"Dallas",DEN:"Denver",DET:"Detroit",GB:"Green Bay",HOU:"Houston",IND:"Indianapolis",JAX:"Jacksonville",KC:"Kansas City",LA:"LA Rams",LAC:"LA Chargers",LV:"Las Vegas",MIA:"Miami",MIN:"Minnesota",NE:"New England",NO:"New Orleans",NYG:"NY Giants",NYJ:"NY Jets",PHI:"Philadelphia",PIT:"Pittsburgh",SEA:"Seattle",SF:"San Francisco",TB:"Tampa Bay",TEN:"Tennessee",WAS:"Washington"};
const $=s=>document.querySelector(s);
const esc=t=>String(t??"").replace(/[&<>"]/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c]));
const GAME=Object.fromEntries(D.games.map(g=>[g.id,g]));
const PID=Object.fromEntries(D.players.map((p,i)=>[p.id,i]));
function kick(g){const d=new Date(g.day+"T12:00:00");const [h,m]=g.time.split(":").map(Number);
  return d.toLocaleDateString("en-US",{weekday:"short",month:"numeric",day:"numeric"})+" · "+((h%12)||12)+":"+String(m).padStart(2,"0")+(h<12?" AM":" PM")+" ET";}
function spreadTxt(g){if(g.spread==null)return"";if(g.spread===0)return"Pick'em";const fav=g.spread>0?g.home:g.away;return fav+" -"+Math.abs(g.spread);}
function toast(t){const el=$("#toast");el.textContent=t;el.hidden=false;clearTimeout(toast.t);toast.t=setTimeout(()=>el.hidden=true,1800);}

// ---------- state (saved per viewer) ----------
let state={tab:"match",q:"",pos:"",mkt:"",gm:"",grd:"",be:.542,game:D.games[0]?.id,wonly:false,watch:[],legs:[],mult:{2:3,3:5,4:10,5:20,6:37.5},week:D.week,myTeam:[],rostered:[],cmp:[],fv:"team",rpos:"",showRost:false};
try{const s=JSON.parse(localStorage.getItem("overlay-v3")||"null");if(s)Object.assign(state,s,{q:""});}catch(e){}
if(state.week!==D.week){state.legs=[];state.week=D.week;}  // new week, fresh slip
state.legs=state.legs.filter(l=>PID[l.id]!==undefined);
if(!GAME[state.game])state.game=D.games[0]?.id;
function save(){try{localStorage.setItem("overlay-v3",JSON.stringify(state));}catch(e){}}

// ---------- odds lines (filled once an Odds API key is added) ----------
const imp=o=>o<0?(-o)/(-o+100):100/(o+100);
const norm=s=>String(s||"").toLowerCase().replace(/\b(jr|sr|ii|iii|iv)\b/g,"").replace(/[^a-z]/g,"");
const SHARP=["pinnacle","fanduel","draftkings","betmgm","espnbet","betrivers","bovada"];const LINES={},LINES_PREV={};
for(const l of D.lines||[]){const k=norm(l.player)+"|"+l.market;(LINES[k]=LINES[k]||[]).push(l);}
for(const l of D.linesPrev||[]){const k=norm(l.player)+"|"+l.market;(LINES_PREV[k]=LINES_PREV[k]||[]).push(l);}
const HAS_PREV=(D.linesPrev||[]).length>0;
const BOOKNAME={pinnacle:"Pinnacle",fanduel:"FanDuel",draftkings:"DraftKings",betmgm:"BetMGM",espnbet:"ESPN Bet",betrivers:"BetRivers",bovada:"Bovada",prizepicks:"PrizePicks",underdog:"Underdog",pick6:"DK Pick6"};
const BOOKW={pinnacle:3,fanduel:1.5,draftkings:1.5,betmgm:1,espnbet:1,betrivers:1,bovada:.5}; // sharper books count more
const DFS=["prizepicks","underdog","pick6"];
function sdFor(pr){const k=pr.stat==="Receptions"?.42:pr.stat==="Pass Yds"?.24:.5;
  return Math.max(Math.sqrt(.5*pr.sd*pr.sd+.5*Math.pow(k*Math.max(pr.proj,1),2)),pr.stat==="Receptions"?1:5);}
function zinv(p){let lo=-8,hi=8;for(let i=0;i<60;i++){const m=(lo+hi)/2;if(cdf(m)<p)lo=m;else hi=m;}return(lo+hi)/2;}
// every sportsbook's two-sided line for this prop: no-vig over chance at its own line
function bookLines(p,pr,M=LINES){const ls=M[norm(p.name)+"|"+pr.market];if(!ls)return[];const out=[];
  for(const b of SHARP){const byLine={};for(const l of ls)if(l.book===b)(byLine[l.line]=byLine[l.line]||{})[l.side]=l.price;
    for(const [ln,o] of Object.entries(byLine)){if(o.Over==null||o.Under==null)continue;const a=imp(o.Over),c=imp(o.Under);out.push({book:b,line:+ln,over:o.Over,under:o.Under,fair:a/(a+c)});}}
  return out;}
// weighted consensus of all books, each adjusted from its own line to the target line
function marketChance(p,pr,line,side,M=LINES){const all=bookLines(p,pr,M);if(!all.length)return null;
  const sd=sdFor(pr),lim=Math.max(3,.12*line);let wsum=0,psum=0;const used=[];
  for(const b of SHARP){const opts=all.filter(x=>x.book===b);if(!opts.length)continue;
    const x=opts.reduce((m,o)=>Math.abs(o.line-line)<Math.abs(m.line-line)?o:m);const d=Math.abs(x.line-line);if(d>lim)continue;
    const over=d<1e-9?x.fair:1-cdf((line-(x.line+sd*zinv(x.fair)))/sd);const w=BOOKW[b]||1;wsum+=w;psum+=w*over;used.push({...x,adjOver:over});}
  if(!wsum)return null;const over=psum/wsum;
  const avg=used.reduce((s,x)=>s+x.line,0)/used.length;
  return{p:side==="More"?over:1-over,n:used.length,books:used,adjusted:used.some(x=>Math.abs(x.line-line)>1e-9),avgLine:Math.round(avg*2)/2,
    book:used.find(x=>x.book==="pinnacle")?"pinnacle":used[0].book,line:used[0].line};}
function priceFor(p,pr,M=LINES){const ls=M[norm(p.name)+"|"+pr.market];if(!ls)return null;
  const pp=ls.find(l=>l.book==="prizepicks"&&l.side==="Over");if(!pp)return null;
  const ud=ls.find(l=>l.book==="underdog"&&l.side==="Over");const m=marketChance(p,pr,pp.line,"More",M);
  return{line:pp.line,ud:ud?.line,fair:m?m.p:null,n:m?.n||0,avgLine:m?.avgLine,adjusted:m?.adjusted,book:m?.book,from:m?.line};}
const HAS_LINES=(D.lines||[]).length>0;

// ---------- math ----------
function grade(rank){return rank>=26?"A":rank>=20?"B":rank>=13?"C":rank>=7?"D":"F";}
function erf(x){const t=1/(1+.3275911*Math.abs(x));const y=1-(((((1.061405429*t-1.453152027)*t)+1.421413741)*t-.284496736)*t+.254829592)*t*Math.exp(-x*x);return x>=0?y:-y;}
const cdf=z=>.5*(1+erf(z/Math.SQRT2));
function modelChance(pr,line,side){const over=1-cdf((line-pr.proj)/sdFor(pr));return side==="More"?over:1-over;}
function chanceInfo(p,pr,line,side){const m=marketChance(p,pr,line,side);return m?{p:m.p,src:"market",m}:{p:modelChance(pr,line,side),src:"model"};}
const USE={"Pass Yds":{f:x=>x.att,u:"pass att"},"Rush Yds":{f:x=>x.car,u:"carries"},"Rec Yds":{f:x=>x.tgt,u:"targets"},"Receptions":{f:x=>x.tgt,u:"targets"}};
function trend(p,stat){const u=p.usage,m=USE[stat];if(!m||u.length<3)return{cls:"flat",txt:"–"};
  const last=u.slice(-2).map(m.f),prev=u.slice(0,-2).map(m.f);const a=last.reduce((s,v)=>s+v,0)/last.length,b=prev.reduce((s,v)=>s+v,0)/prev.length;
  const d=b?(a-b)/b:(a>0?1:0);const pct=Math.round(d*100);const sig=Math.abs(d)>.15&&Math.abs(a-b)>=1;
  return{cls:sig?(d>0?"up":"dn"):"flat",txt:`${sig?(d>0?"▲ ":"▼ "):""}${a%1?a.toFixed(1):a} ${m.u}${sig?` (${pct>0?"+":""}${pct>999?"999+":pct}%)`:""}`,d};}

// ---------- rows ----------
const ROWS=[];
D.players.forEach((p,pi)=>{p.props.forEach((pr,ki)=>{
  const d=(D.defense[p.opp]||{})[p.pos+"|"+pr.stat];if(!d)return;
  const MIN={"Rec Yds":p.pos==="RB"?12:20,"Receptions":2,"Rush Yds":p.pos==="QB"?12:20,"Pass Yds":120};
  if(pr.avg<(MIN[pr.stat]||0))return;
  ROWS.push({p,pr,pi,ki,d,lg:D.league[p.pos+"|"+pr.stat],g:grade(d.rank),price:priceFor(p,pr),prev:HAS_PREV?priceFor(p,pr,LINES_PREV):null});
});});
const isWatched=id=>state.watch.includes(id);
function toggleWatch(id){state.watch=isWatched(id)?state.watch.filter(x=>x!==id):[...state.watch,id];save();renderMatch();
  document.querySelectorAll(`.star[data-w="${CSS.escape(id)}"]`).forEach(b=>b.setAttribute("aria-pressed",isWatched(id)));}

function moveOf(r){if(!r.price||!r.prev)return null;const dl=r.price.line-r.prev.line;
  let dw=null;if(r.win!=null&&r.prev.fair!=null){const pw=r.side==="More"?r.prev.fair:1-r.prev.fair;dw=r.win-pw;}
  if(Math.abs(dl)<.01&&(dw==null||Math.abs(dw)<.01))return null;return{dl,dw,from:r.prev.line};}
const prevAt=D.oddsPrev&&D.oddsPrev.fetched?new Date(D.oddsPrev.fetched).toLocaleDateString("en-US",{weekday:"short"}):"last pull";
function booksHint(r){const a=r.price&&r.price.avgLine;if(a==null||Math.abs(a-r.price.line)<1)return"";
  return `<div class="mv flat" title="Average line across ${r.price.n} sportsbooks">Books ${a}</div>`;}
function lineMv(m){return m&&Math.abs(m.dl)>=.01?`<div class="mv ${m.dl>0?"up":"dn"}" title="PrizePicks line on ${prevAt}: ${m.from}">${m.dl>0?"▲":"▼"} from ${m.from}</div>`:"";}
function winMv(m){return m&&m.dw!=null&&Math.abs(m.dw)>=.01?`<div class="mv ${m.dw>0?"up":"dn"}" title="Change in hit chance since ${prevAt}">${m.dw>0?"▲":"▼"}${Math.round(Math.abs(m.dw)*100)} since ${prevAt}</div>`:"";}
function matchTitle(r){return `${NAMES[r.p.opp]} allows ${r.d.avg} ${r.pr.stat.toLowerCase()} a game to ${r.p.pos}s (rank ${r.d.rank} of 32; league avg ${r.lg})`;}
function renderMatch(){
  const L=HAS_LINES;
  $("#matchhead").innerHTML=L
    ?`<tr><th aria-label="Watchlist"></th><th>Player</th><th>Stat</th><th class="num">PP line</th><th>Play</th><th class="num" title="Sportsbooks' no-vig chance this pick hits">Hit chance</th><th>Matchup</th><th>Usage</th><th class="num" title="Overlay's own rough projection">Our proj</th><th>Status</th><th aria-label="Open"></th></tr>`
    :`<tr><th aria-label="Watchlist"></th><th>Player</th><th>Stat</th><th class="num">Season avg</th><th class="num" title="Overlay's own rough projection">Our proj</th><th>Matchup</th><th>Usage</th><th>Status</th><th aria-label="Open"></th></tr>`;
  let list=ROWS.filter(r=>(!state.q||r.p.name.toLowerCase().includes(state.q.toLowerCase()))&&(!state.pos||r.p.pos===state.pos)&&(!state.mkt||r.pr.stat===state.mkt)&&(!state.gm||r.p.game===state.gm)&&(!state.grd||state.grd.includes(r.g))&&(!state.wonly||isWatched(r.p.id)));
  list=list.map(r=>{let e=null,side=null,win=null;if(r.price&&r.price.fair!=null){side=r.price.fair>=.5?"More":"Less";win=Math.max(r.price.fair,1-r.price.fair);e=win-state.be;}const o={...r,e,side,win};o.mv=moveOf(o);return o;});
  if(state.moved)list=list.filter(r=>r.mv);
  list.sort(L?(a,b)=>(b.e??-9)-(a.e??-9)||(b.price?1:0)-(a.price?1:0):(a,b)=>(b.pr.proj-b.pr.avg)/b.pr.avg-(a.pr.proj-a.pr.avg)/a.pr.avg);
  const nf=["pos","mkt","gm","grd"].filter(k=>state[k]).length+(state.wonly?1:0)+(state.q?1:0)+(state.moved?1:0);
  $("#ftoggle").textContent=nf?`Filters (${nf})`:"Filters";
  const cols=L?11:9;
  if(!list.length){const msg=state.wonly&&!state.watch.length?"Your watchlist is empty. Tap the star next to any player to add him.":state.moved&&!HAS_PREV?"Line movement shows after the second odds pull of the week (Saturday).":"No players match these filters. Clear a filter to see more.";
    $("#matchbody").innerHTML=`<tr><td colspan="${cols}" class="empty">${msg}</td></tr>`;$("#matchcards").innerHTML=`<div class="panel empty">${msg}</div>`;return;}
  const edgeTxt=r=>r.e!=null?`<span class="edge ${r.e>0?"hot":"cold"}" title="Consensus of ${r.price.n} sportsbook${r.price.n>1?"s":""}: ${(r.win*100).toFixed(1)}%${r.price.adjusted?", adjusted to this line":""}. Your slip needs ${(state.be*100).toFixed(1)}%.">${(r.win*100).toFixed(0)}%</span>${r.price.adjusted?'<span class="sub"> adj</span>':""}`:'<span class="sub">–</span>';
  const playTxt=r=>r.side?`<span class="pick ${r.side==="More"?"more":"less"}">${r.side}</span>`:'<span class="sub">Books not posted</span>';
  const stTxt=r=>r.p.status?`<span class="st ${r.p.status}">${r.p.status}</span>`:"";
  const head=r=>`<div class="pname plink">${esc(r.p.name)}</div><div class="sub">${r.p.pos} · ${r.p.team} ${GAME[r.p.game]?.home===r.p.team?"vs":"@"} ${r.p.opp}</div>`;
  $("#matchbody").innerHTML=list.map(r=>{const t=trend(r.p,r.pr.stat);
    const star=`<td><button class="star" data-w="${esc(r.p.id)}" aria-pressed="${isWatched(r.p.id)}" aria-label="Watch ${esc(r.p.name)}">★</button></td>`;
    const match=`<td><span class="chip g-${r.g}" title="${esc(matchTitle(r))}">${r.g} matchup</span></td>`;
    const use=`<td><span class="trend ${t.cls}">${t.txt}</span></td>`;
    const tail=`<td>${stTxt(r)}</td><td class="chev" aria-hidden="true">›</td></tr>`;
    if(L)return `<tr class="click" tabindex="0" data-pi="${r.pi}" data-ki="${r.ki}" title="Open full breakdown">${star}<td>${head(r)}</td><td>${r.pr.stat}</td>
      ${r.price?`<td class="num">${r.price.line}${booksHint(r)}${lineMv(r.mv)}</td><td>${playTxt(r)}</td><td class="num">${edgeTxt(r)}${winMv(r.mv)}</td>`:'<td class="num sub" colspan="3">Not on PrizePicks</td>'}
      ${match}${use}<td class="num">${r.pr.proj}</td>${tail}`;
    return `<tr class="click" tabindex="0" data-pi="${r.pi}" data-ki="${r.ki}" title="Open full breakdown">${star}<td>${head(r)}</td><td>${r.pr.stat}</td><td class="num">${r.pr.avg}</td><td class="num">${r.pr.proj}</td>${match}${use}${tail}`;}).join("");
  $("#matchcards").innerHTML=list.slice(0,80).map(r=>{const t=trend(r.p,r.pr.stat);
    const line=r.price?`<span class="bigline">${r.pr.stat} ${r.price.line}</span>${r.price.avgLine!=null&&Math.abs(r.price.avgLine-r.price.line)>=1?`<span class="sub">books ${r.price.avgLine}</span>`:""}${playTxt(r)}${r.e!=null?edgeTxt(r)+'<span class="sub"> to hit</span>':""}${r.mv?`<span class="mv ${(r.mv.dw??r.mv.dl)>0?"up":"dn"}">${Math.abs(r.mv.dl)>=.01?`line ${r.mv.dl>0?"▲":"▼"} from ${r.mv.from}`:`${r.mv.dw>0?"▲":"▼"}${Math.round(Math.abs(r.mv.dw)*100)} since ${prevAt}`}</span>`:""}`:`<span class="bigline">${r.pr.stat}</span><span class="sub">avg ${r.pr.avg} · proj ${r.pr.proj}</span>`;
    return `<div class="pcard click" role="button" tabindex="0" data-pi="${r.pi}" data-ki="${r.ki}">
      <div class="top"><div style="min-width:0">${head(r)}</div><div style="display:flex;gap:6px;align-items:center">${stTxt(r)}<button class="star" data-w="${esc(r.p.id)}" aria-pressed="${isWatched(r.p.id)}" aria-label="Watch ${esc(r.p.name)}">★</button></div></div>
      <div class="play">${line}</div>
      <div class="foot"><div class="play"><span class="chip g-${r.g}">${r.g} matchup</span><span class="trend ${t.cls}">${t.txt}</span></div><span class="more-link">Details ›</span></div></div>`;}).join("")+(list.length>80?`<p class="sub">Showing the top 80. Use Filters to narrow the list.</p>`:"");
}

// ---------- charts ----------
function bars(values,ref,refLabel,label,line){
  const hasO=values.some(v=>v.o);const W=460,H=hasO?164:150,pad={l:36,r:8,t:14,b:hasO?38:24};const n=Math.max(values.length,1);
  const max=Math.max(...values.map(v=>v.v),ref,line??0,1)*1.18;
  const y=v=>pad.t+(H-pad.t-pad.b)*(1-v/max);const bw=(W-pad.l-pad.r)/n;
  const step=max>40?Math.ceil(max/2/10)*10:Math.max(1,Math.ceil(max/2));const ticks=[0,step,step*2].filter(t=>t<=max);
  const cut=line??ref;
  return `<svg class="chart" viewBox="0 0 ${W} ${H}" role="img" aria-label="${esc(label)}">
  ${ticks.map(t=>`<line x1="${pad.l}" x2="${W-pad.r}" y1="${y(t)}" y2="${y(t)}" stroke="var(--line)" opacity=".7"/><text x="${pad.l-6}" y="${y(t)+4}" text-anchor="end">${t}</text>`).join("")}
  ${values.map((v,k)=>`<rect x="${pad.l+k*bw+bw*.22}" y="${y(v.v)}" width="${bw*.56}" height="${Math.max(0,y(0)-y(v.v))}" rx="2" fill="${v.v>cut?"var(--pos)":"var(--line)"}"/>
   <text x="${pad.l+k*bw+bw/2}" y="${y(v.v)-4}" text-anchor="middle">${v.v}</text><text x="${pad.l+k*bw+bw/2}" y="${hasO?H-21:H-7}" text-anchor="middle">Wk ${v.wk}</text>${v.o?`<text x="${pad.l+k*bw+bw/2}" y="${H-6}" text-anchor="middle" style="fill:var(--fg)">${esc(v.o)}</text>`:""}`).join("")}
  <line x1="${pad.l}" x2="${W-pad.r}" y1="${y(cut)}" y2="${y(cut)}" stroke="var(--accent)" stroke-width="2" stroke-dasharray="5 4"/>
  </svg><div class="sub"><span style="color:var(--accent)">- - -</span> ${esc(line!=null?"Your line "+line:refLabel)}</div>`;
}
function injList(t){const l=D.injuries[t]||[];if(!l.length)return'<p class="sub">No players listed on the last report.</p>';
  return l.map(x=>`<div class="injrow"><div><div class="pname">${esc(x.name)} <span class="sub">${esc(x.pos)}</span></div><div class="sub">${esc(x.injury||"Not specified")}${x.practice?" · "+esc(x.practice):""}</div></div><span class="st ${x.status}">${x.status}</span></div>`).join("");}
const pctf=x=>x==null?"–":Math.round(x*100)+"%";

// ---------- player sheet ----------
let cur=null; // {pi,ki,line,side}
function openPlayer(pi,ki){if(!state.tipDone){state.tipDone=true;save();const t=$("#tip");if(t)t.hidden=true;}
  const p=D.players[pi],pr=p.props[ki];const price=priceFor(p,pr);
  const existing=state.legs.find(l=>l.id===p.id&&l.stat===pr.stat);
  cur={pi,ki,side:existing?.side||"More",line:existing?.line??price?.line??Math.round(pr.proj)-.5};
  if(cur.line<=0)cur.line=.5;
  drawSheet();$("#sheet").hidden=false;$("#scrim").hidden=false;$("#sheet").scrollTop=0;$("#closebtn").focus();
}
function fmtOdds(o){return o>0?"+"+o:String(o);}
function lineShop(p,pr){const ls=LINES[norm(p.name)+"|"+pr.market];if(!ls)return"";
  const side=cur?.side||"More";
  const dfs=DFS.map(b=>{const o=ls.find(l=>l.book===b&&l.side==="Over");return o?{book:b,line:o.line}:null;}).filter(Boolean);
  const best=dfs.length?(side==="More"?Math.min(...dfs.map(x=>x.line)):Math.max(...dfs.map(x=>x.line))):null;
  const books=bookLines(p,pr).sort((a,b)=>SHARP.indexOf(a.book)-SHARP.indexOf(b.book)||a.line-b.line);
  if(!dfs.length&&!books.length)return"";
  const rows=dfs.map(x=>`<tr${x.line===best&&dfs.length>1?' class="bestline"':""}><td>${BOOKNAME[x.book]}${x.line===best&&dfs.length>1?` <span class="chip g-A">Best for ${side}</span>`:""}</td><td>${x.line}</td><td class="sub" colspan="3">Pick'em app, no odds</td></tr>`).join("")
    +books.map(x=>`<tr><td>${BOOKNAME[x.book]}</td><td>${x.line}</td><td>${fmtOdds(x.over)}</td><td>${fmtOdds(x.under)}</td><td>${Math.round((side==="More"?x.fair:1-x.fair)*100)}%</td></tr>`).join("");
  return `<details class="inj" open><summary>Line shop · ${books.length?new Set(books.map(b=>b.book)).size+" sportsbooks":"no sportsbooks yet"} ›</summary>
   <div style="overflow-x:auto"><table class="mini shop"><thead><tr><th>Book</th><th>Line</th><th>More</th><th>Less</th><th>${side} chance</th></tr></thead><tbody>${rows}</tbody></table></div>
   <p class="sub" style="margin-top:6px">Chance is each book's own no-vig price at its own line. Overlay's hit chance blends them at the PrizePicks line, counting Pinnacle most and Bovada least.</p></details>`;}
function hitStats(p,pr,line,side){const L=pr.log;const hit=v=>side==="More"?v.v>line:v.v<line;
  const l5=L.slice(-5);const c=chanceInfo(p,pr,line,side);return{l5:l5.filter(hit).length+"/"+l5.length,season:L.filter(hit).length+"/"+L.length,est:c.p,src:c.src,m:c.m};}
function drawSheet(){
  const {pi,ki}=cur;const p=D.players[pi],pr=p.props[ki];const key=p.pos+"|"+pr.stat;const d=D.defense[p.opp][key];const lg=D.league[key];const g=grade(d.rank);const G=GAME[p.game];
  const kind=g==="A"||g==="B"?"good":g==="C"?"mid":"bad";
  const soft=d.rank>=26?"one of the softest":d.rank>=20?"softer than average":d.rank>=13?"about average":d.rank>=7?"tougher than average":"one of the toughest";
  const pctDiff=Math.round((d.avg-lg)/lg*100);const price=priceFor(p,pr);const h=hitStats(p,pr,cur.line,cur.side);
  const be=+state.be;const inSlip=state.legs.some(l=>l.id===p.id&&l.stat===pr.stat);
  const statBtns=p.props.map((x,k)=>`<button class="btn" ${k===ki?'aria-current="true" style="border-color:var(--accent);color:var(--accent)"':""} data-pi="${pi}" data-ki="${k}" data-switch="1">${esc(x.stat)}</button>`).join(" ");
  const oppWk=Object.fromEntries((pr.log||[]).map(x=>[x.wk,x.o||""]));
  const usageRows=p.usage.map(u=>`<tr><td>Wk ${u.wk} <span class="sub">${esc(oppWk[u.wk]||"")}</span></td><td>${pctf(u.snap)}</td>${p.pos==="QB"?`<td>${u.att}</td><td>${u.car}</td>`:p.pos==="RB"?`<td>${u.car}</td><td>${pctf(u.cshare)}</td><td>${u.tgt}</td>`:`<td>${u.tgt}</td><td>${pctf(u.tshare)}</td>`}</tr>`).join("");
  const usageHead=p.pos==="QB"?"<th>Snaps</th><th>Pass att</th><th>Carries</th>":p.pos==="RB"?"<th>Snaps</th><th>Carries</th><th>Carry share</th><th>Targets</th>":"<th>Snaps</th><th>Targets</th><th>Target share</th>";
  const splits=(p.splits||[]).filter(s=>(s.tgt||0)>=4||(s.car||0)>=8||s.pos==="QB");
  const splitHtml=splits.map(s=>{const vac=s.pos==="QB"?"the starting QB job":[s.tgt>=1?`${s.tgt} targets`:"",s.car>=1?`${s.car} carries`:""].filter(Boolean).join(" and ")+" a game";
    const body=s.nWithout?`Without him (${s.nWithout} game${s.nWithout>1?"s":""}): ${esc(p.name)} averaged <b>${s.statWithout}</b> ${esc(s.stat.toLowerCase())} on ${s.useWithout} opportunities, vs <b>${s.statWith??"–"}</b> on ${s.useWith??"–"} with him (${s.nWith} game${s.nWith!==1?"s":""}).`:`${esc(p.name)} hasn't played a game without him yet this season.`;
    return `<div class="split"><b>${esc(s.name)}</b> (${s.pos}, ${s.status} on the last report) leaves ${vac} open.<br>${body}${s.nWithout&&s.nWithout<3?' <span class="sub">Small sample.</span>':""}</div>`;}).join("");
  const qbKey=p.team===G.home?"Home":"Away";const qbNow=G["qb"+qbKey],qbLast=G["qb"+qbKey+"Last"];
  const qbChange=qbNow&&qbLast&&norm(qbNow)!==norm(qbLast);
  const impPts=p.team===G.home?G.impHome:G.impAway;
  $("#sheet").innerHTML=`
   <div class="sheethead"><div><h2>${esc(p.name)}</h2><div class="sub">${p.pos} · ${NAMES[p.team]} vs ${NAMES[p.opp]} · ${kick(G)}</div></div>
   <div style="display:flex;gap:6px;align-items:start"><button class="star" data-w="${esc(p.id)}" aria-pressed="${isWatched(p.id)}" aria-label="Watch">★</button><button class="close" id="closebtn">Close</button></div></div>
   ${p.status?`<p><span class="st ${p.status}">${p.status}</span> on the latest injury report.</p>`:""}
   <div style="display:flex;flex-wrap:wrap;gap:6px;margin:12px 0">${statBtns}</div>
   <div class="checker">
     <div class="row"><label for="lineinput" class="sub" style="font-weight:600;letter-spacing:.06em;text-transform:uppercase">PrizePicks line</label>
       <input type="number" id="lineinput" step="0.5" min="0" value="${cur.line}">
       <div class="seg"><button class="more" data-side="More" aria-pressed="${cur.side==="More"}">More</button><button class="less" data-side="Less" aria-pressed="${cur.side==="Less"}">Less</button></div></div>
     <div class="hits" id="hitsbox">${hitsHtml(h,be)}</div>
     <div class="row" style="justify-content:space-between"><span class="sub">Needs about ${(be*100).toFixed(1)}% to beat your slip type. <span id="estsrc">${srcText(h)}</span></span>
       <button class="btn primary" id="addleg">${inSlip?"Update slip":"Add to slip"}</button></div>
   </div>
   <div class="verdict ${kind}"><strong>${g} matchup for ${esc(pr.stat.toLowerCase())}</strong>
   ${NAMES[p.opp]} is ${soft} against ${p.pos}s here. They allow ${d.avg} ${pr.stat.toLowerCase()} per game to the position, ${Math.abs(pctDiff)}% ${pctDiff>=0?"above":"below"} the league average of ${lg} (rank ${d.rank} of 32). Projection: <b>${pr.proj}</b> (season avg ${pr.avg}).
   ${price&&price.fair!=null?`<br>${price.n} sportsbook${price.n>1?"s":""} (fee removed${price.adjusted?", adjusted to this line":""}) make ${price.fair>=.5?"More":"Less"} ${price.line} a <b>${(Math.max(price.fair,1-price.fair)*100).toFixed(1)}%</b> chance.`:""}${(()=>{const pv=HAS_PREV?priceFor(p,pr,LINES_PREV):null;if(!price||!pv)return"";const parts=[];if(pv.line!==price.line)parts.push(`PrizePicks moved from ${pv.line} to ${price.line}`);if(pv.fair!=null&&price.fair!=null&&Math.abs(pv.fair-price.fair)>=.01)parts.push(`the books' chance of More went from ${Math.round(pv.fair*100)}% to ${Math.round(price.fair*100)}%`);return parts.length?`<br>Since ${prevAt}: ${parts.join(", and ")}.`:"";})()}</div>
   ${lineShop(p,pr)}
   <div class="sec">${esc(p.name)} · ${pr.stat} by game</div>
   <div id="logchart">${bars(pr.log.slice(-6),pr.avg,"Season avg "+pr.avg,"Player game log",cur.line)}</div>
   <div class="sec">Usage by game</div>
   <div style="overflow-x:auto"><table class="mini"><thead><tr><th>Game</th>${usageHead}</tr></thead><tbody>${usageRows}</tbody></table></div>
   ${splitHtml?`<div class="sec">Teammates out</div>${splitHtml}`:""}
   <div class="sec">Game environment</div>
   <div class="envrow">${impPts!=null?`<span class="flag">${p.team} implied ${impPts} pts</span>`:""}<span class="flag">${spreadTxt(G)||"No line"}</span>${G.total?`<span class="flag">O/U ${G.total}</span>`:""}${G.roof?`<span class="flag">${G.roof==="dome"||G.roof==="closed"?"Indoors":G.roof==="outdoors"?"Outdoors":esc(G.roof)}</span>`:""}${G.wind!=null&&G.wind>=15?`<span class="flag warn">Wind ${G.wind} mph</span>`:""}${(p.team===G.home?G.restHome:G.restAway)<=5?`<span class="flag warn">Short rest</span>`:""}${qbChange?`<span class="flag warn">QB change: ${esc(qbNow)} expected</span>`:""}</div>
   <div class="sec">${esc(pr.stat)} allowed by ${NAMES[p.opp]} to ${p.pos}s, by game</div>
   ${bars(d.last,lg,"League avg "+lg,"Defense allowed by week")}
   <details class="inj"><summary>Injury reports · ${p.team} (${(D.injuries[p.team]||[]).length}) · ${p.opp} (${(D.injuries[p.opp]||[]).length}) ›</summary>
   <div class="sec">${NAMES[p.team]}</div>${injList(p.team)}
   <div class="sec">${NAMES[p.opp]}</div>${injList(p.opp)}</details>`;
  $("#closebtn").onclick=closeSheet;
  $("#lineinput").oninput=e=>{const v=parseFloat(e.target.value);if(!isNaN(v)){cur.line=v;updateChecker();}};
  document.querySelectorAll(".seg button").forEach(b=>b.onclick=()=>{cur.side=b.dataset.side;document.querySelectorAll(".seg button").forEach(x=>x.setAttribute("aria-pressed",x===b));updateChecker();const y=$("#sheet").scrollTop;const ls=document.querySelector("#sheet details.inj[open] table.shop");if(ls){const det=ls.closest("details");det.outerHTML=lineShop(D.players[cur.pi],D.players[cur.pi].props[cur.ki]);}$("#sheet").scrollTop=y;});
  $("#addleg").onclick=()=>{const leg={id:p.id,stat:pr.stat,line:cur.line,side:cur.side};
    state.legs=state.legs.filter(l=>!(l.id===p.id&&l.stat===pr.stat));state.legs.push(leg);save();renderSlip();$("#addleg").textContent="Update slip";toast(`Added ${p.name} ${cur.side} ${cur.line}`);};
}
function hitsHtml(h,be){return `<div><span>Last 5</span><b>${h.l5}</b></div><div><span>Season</span><b>${h.season}</b></div>
       <div><span>${h.src==="market"?"Book chance":"Est. chance"}</span><b style="color:${h.est>=be?"var(--pos)":"var(--fg)"}">${(h.est*100).toFixed(0)}%</b></div>`;}
function srcText(h){if(h.src!=="market")return"Rough estimate from his game logs and this matchup. No sportsbook price for this prop yet.";const m=h.m;
  return `Consensus of ${m.n} sportsbook${m.n>1?"s":""}' no-vig prices${m.adjusted?", adjusted to this line":""}.`;}
function updateChecker(){if(!cur)return;const p=D.players[cur.pi],pr=p.props[cur.ki];  // update results only, never the input itself
  const hh=hitStats(p,pr,cur.line,cur.side);$("#hitsbox").innerHTML=hitsHtml(hh,+state.be);$("#estsrc").textContent=srcText(hh);
  $("#logchart").innerHTML=bars(pr.log.slice(-6),pr.avg,"Season avg "+pr.avg,"Player game log",cur.line);}
function closeSheet(){$("#sheet").hidden=true;$("#scrim").hidden=true;cur=null;}
$("#scrim").onclick=closeSheet;
document.addEventListener("keydown",e=>{if(e.key==="Escape")closeSheet();});

// ---------- slip ----------
const RECV=["Rec Yds","Receptions"];
function correlations(legs){const out=[];
  for(let i=0;i<legs.length;i++)for(let j=i+1;j<legs.length;j++){const a=legs[i],b=legs[j];const A=a.p,B=b.p;
    const nm=`${A.name} and ${B.name}`;
    if(A.id===B.id){out.push({k:a.side===b.side?"plus":"minus",t:`${A.name}: two picks on the same player ${a.side===b.side?"tend to hit or miss together":"pull against each other"}.`});continue;}
    if(A.game!==B.game)continue;
    const same=A.team===B.team;
    const qb=[a,b].find(x=>x.p.pos==="QB"&&x.stat==="Pass Yds"),rc=[a,b].find(x=>x!==qb&&RECV.includes(x.stat));
    if(same&&qb&&rc){out.push({k:qb.side===rc.side?"plus":"minus",t:qb.side===rc.side?`${nm}: QB and receiver on the same team. Stacked in the same direction, these tend to hit together.`:`${nm}: QB and his receiver in opposite directions usually conflict.`});continue;}
    if(same&&RECV.includes(a.stat)&&RECV.includes(b.stat)&&a.side==="More"&&b.side==="More"&&A.pos!=="QB"&&B.pos!=="QB"){out.push({k:"minus",t:`${nm} compete for the same targets. Both going over is less likely than it looks.`});continue;}
    if(same&&a.stat==="Rush Yds"&&b.stat==="Rush Yds"&&A.pos==="RB"&&B.pos==="RB"&&a.side==="More"&&b.side==="More"){out.push({k:"minus",t:`${nm} split the same backfield carries.`});continue;}
    if(!same&&a.side==="More"&&b.side==="More"&&[a,b].every(x=>x.stat==="Pass Yds"||RECV.includes(x.stat))){out.push({k:"plus",t:`${nm}: passing overs on both sides of the same game. A shootout helps both.`});continue;}
    if(!same){const rb=[a,b].find(x=>x.p.pos==="RB"&&x.stat==="Rush Yds"&&x.side==="More"),pass=[a,b].find(x=>x!==rb&&x.stat==="Pass Yds"&&x.side==="More");
      if(rb&&pass)out.push({k:"plus",t:`${rb.p.name} rushing over and ${pass.p.name} passing over fit the same script: one team leads and runs, the other throws to catch up.`});}
  }return out;}
let undoLegs=null;
const SIZE_FOR_BE={"0.542":6,"0.543":5,"0.562":4,"0.577":2};
function buildBestSlip(n){
  const cand=ROWS.filter(r=>r.price&&r.price.fair!=null&&!["Out","Doubtful","Questionable"].includes(r.p.status)).map(r=>{const side=r.price.fair>=.5?"More":"Less";return{r,side,win:Math.max(r.price.fair,1-r.price.fair)};}).sort((a,b)=>b.win-a.win);
  const picked=[],perGame={},players=new Set();
  for(const c of cand){if(picked.length>=n)break;const p=c.r.p;
    if(players.has(p.id)||(perGame[p.game]||0)>=2)continue;
    const leg={id:p.id,stat:c.r.pr.stat,line:c.r.price.line,side:c.side,p};
    if(correlations([...picked,leg]).some(x=>x.k==="minus"))continue;
    picked.push(leg);players.add(p.id);perGame[p.game]=(perGame[p.game]||0)+1;}
  return picked.map(({id,stat,line,side})=>({id,stat,line,side}));}
function bestBar(){const n=state.bestN||SIZE_FOR_BE[String(state.be)]||6;
  if(!HAS_LINES)return'<div class="bestrow"><span class="sub">"Build my best slip" turns on once PrizePicks lines are loaded.</span></div>';
  return `<div class="bestrow"><button class="btn primary" id="bestbtn">Build my best slip</button>
    <label for="bestn" class="sub">Picks <select id="bestn">${[2,3,4,5,6].map(k=>`<option ${k===n?"selected":""}>${k}</option>`).join("")}</select></label>
    ${undoLegs?'<button class="btn" id="undobest">Undo</button>':""}
    <span class="sub">Highest sportsbook hit chances, one pick per player, at most 2 per game, no injured players, no picks that work against each other.</span></div>`;}
function wireBest(){const b=$("#bestbtn");if(b)b.onclick=()=>{const n=+($("#bestn").value);state.bestN=n;const legs=buildBestSlip(n);
    if(!legs.length){toast("No priced props available yet");return;}
    undoLegs=state.legs.slice();state.legs=legs;save();renderSlip();toast(`Built a ${legs.length}-pick slip`);};
  const nb=$("#bestn");if(nb)nb.onchange=e=>{state.bestN=+e.target.value;save();};
  const u=$("#undobest");if(u)u.onclick=()=>{state.legs=undoLegs||[];undoLegs=null;save();renderSlip();toast("Restored your previous slip");};}
function renderSlip(){
  const legs=state.legs.map(l=>{const p=D.players[PID[l.id]];const pr=p.props.find(x=>x.stat===l.stat);const c=chanceInfo(p,pr,l.line,l.side);return{...l,p,pr,est:c.p,src:c.src};});
  const n=legs.length;$("#slipcount").hidden=!n;$("#slipcount").textContent=n;
  if(!n){$("#sliplegs").innerHTML='<h3>Your picks</h3>'+bestBar()+'<p class="sub">No picks yet. Tap Build my best slip, or open any player on the Props tab, set the line, choose More or Less, and tap Add to slip.</p>';
    $("#slipsum").innerHTML='<h3>Slip value</h3><p class="sub">Add at least two picks.</p>';wireBest();return;}
  $("#sliplegs").innerHTML=`<h3>Your picks</h3>`+bestBar()+legs.map((l,i)=>`<div class="leg"><div style="min-width:0"><button class="linkbtn" data-pi="${PID[l.id]}" data-ki="${l.p.props.indexOf(l.pr)}">${esc(l.p.name)}</button>
    <div class="sub">${l.p.pos} · ${l.p.team} vs ${l.p.opp} · ${esc(l.stat)} · proj ${l.pr.proj}</div></div>
    <div class="legr"><span class="pick ${l.side==="More"?"more":"less"}">${l.side} ${l.line}</span><span class="edge ${l.est>=state.be?"hot":"cold"}" title="${l.src==="market"?"Sportsbook price":"Model estimate"}">${Math.round(l.est*100)}%${l.src==="model"?"*":""}</span><button class="x" data-rm="${i}" aria-label="Remove">✕</button></div></div>`).join("")
    +correlations(legs).map(c=>`<div class="corr ${c.k}">${c.k==="plus"?"▲ ":"▼ "}${esc(c.t)}</div>`).join("")
    +`<div style="display:flex;gap:8px;margin-top:12px;flex-wrap:wrap"><button class="btn" id="copyslip">Copy slip</button><button class="btn" id="clearslip">Clear slip</button></div>`;
  const all=legs.reduce((s,l)=>s*l.est,1);const mult=state.mult[n];
  $("#slipsum").innerHTML=`<h3>Slip value</h3>${n<2||n>6?`<p class="sub">PrizePicks slips take 2 to 6 picks.</p>`:`
    <label for="mult" class="sub" style="font-weight:600;letter-spacing:.06em;text-transform:uppercase;display:flex;flex-direction:column;gap:4px">${n}-pick Power payout (x)<input type="number" id="mult" step="0.5" min="1" value="${mult}"></label>
    <div class="sum"><div><span>All hit</span><b>${(all*100).toFixed(1)}%</b></div><div><span>Expected return</span><b style="color:${all*mult>=1?"var(--pos)":"var(--neg)"}">${all*mult>=1?"+":""}${((all*mult-1)*100).toFixed(0)}%</b></div></div>
    <p class="sub">Break-even needs each pick to hit about ${(Math.pow(1/mult,1/n)*100).toFixed(1)}% of the time. The weakest pick is ${esc(legs.reduce((a,b)=>a.est<b.est?a:b).p.name)} at ${Math.round(Math.min(...legs.map(l=>l.est))*100)}%.</p>`}`;
  wireBest();
  const m=$("#mult");if(m)m.onchange=e=>{const v=parseFloat(e.target.value);if(v>0){state.mult[n]=v;save();renderSlip();}};
  $("#clearslip").onclick=()=>{state.legs=[];save();renderSlip();};
  $("#copyslip").onclick=()=>{const t=legs.map(l=>`${l.p.name} ${l.side} ${l.line} ${l.stat}`).join("\n");
    (navigator.clipboard?.writeText(t)||Promise.reject()).then(()=>toast("Slip copied"),()=>{toast("Copy not allowed here");});};
}

// ---------- defense heatmap ----------
const HEATCOLS=[["QB","Pass Yds"],["QB","Rush Yds"],["RB","Rush Yds"],["RB","Receptions"],["WR","Rec Yds"],["WR","Receptions"],["TE","Rec Yds"]];
let heatSort={c:-1,dir:1};
function renderHeat(){
  $("#heathead").innerHTML=`<tr><th class="sortable" data-c="-1">Defense</th>${HEATCOLS.map((c,i)=>`<th class="sortable num" data-c="${i}">${c[0]} ${c[1]}${heatSort.c===i?" ▼":""}</th>`).join("")}</tr>`;
  let teams=Object.keys(D.defense).sort();
  if(heatSort.c>=0){const k=HEATCOLS[heatSort.c].join("|");teams.sort((a,b)=>(D.defense[b][k]?.rank??0)-(D.defense[a][k]?.rank??0));}
  const playing=new Set(D.games.flatMap(g=>[g.home,g.away]));
  $("#heatbody").innerHTML=teams.map(t=>`<tr><td><div class="pname">${t}</div><div class="sub">${playing.has(t)?NAMES[t]:NAMES[t]+" · bye"}</div></td>${HEATCOLS.map(c=>{const d=D.defense[t][c.join("|")];if(!d)return"<td></td>";
    const x=(d.rank-1)/31;const bg=x>.5?`color-mix(in srgb, var(--pos) ${Math.round((x-.5)*2*45)}%, transparent)`:`color-mix(in srgb, var(--neg) ${Math.round((.5-x)*2*35)}%, transparent)`;
    return `<td class="h" style="background:${bg}" title="Rank ${d.rank} of 32">${d.avg}<div class="sub" style="font-weight:400">#${d.rank}</div></td>`;}).join("")}</tr>`).join("");
}
$("#heathead").addEventListener("click",e=>{const th=e.target.closest("th");if(!th)return;heatSort.c=+th.dataset.c;renderHeat();});

// ---------- games tab ----------
function gamePlayers(list){const order={QB:0,RB:1,WR:2,TE:3};
  return list.sort((a,b)=>order[a.p.pos]-order[b.p.pos]).map(({p,pi})=>{
    const chips=p.props.map((pr,k)=>{const pc=priceFor(p,pr);
      if(pc&&pc.fair!=null){const side=pc.fair>=.5?"More":"Less",w=Math.max(pc.fair,1-pc.fair);
        return `<button class="propchip" data-pi="${pi}" data-ki="${k}">${esc(pr.stat)} ${pc.line} <span class="pk ${side==="More"?"more":"less"}">${side.toUpperCase()}</span> <span class="edge ${w-state.be>0?"hot":"cold"}">${Math.round(w*100)}%</span></button>`;}
      if(pc)return `<button class="propchip" data-pi="${pi}" data-ki="${k}">${esc(pr.stat)} ${pc.line} <span class="sub">books not posted</span></button>`;
      return `<button class="propchip" data-pi="${pi}" data-ki="${k}">${esc(pr.stat)} <span class="sub">avg ${pr.avg}</span></button>`;}).join("");
    return `<div class="gprow"><div style="display:flex;justify-content:space-between;gap:8px;align-items:center"><button class="linkbtn" data-pi="${pi}" data-ki="0">${esc(p.name)}</button><span>${p.status?`<span class="st ${p.status}">${p.status}</span>`:""}</span></div>
      <div class="sub">${p.pos} · ${p.team}</div><div class="propchips">${chips}</div></div>`;}).join("");}
function renderGames(){
  $("#gamelist").innerHTML=D.games.map(g=>{
    const all=[...(D.injuries[g.away]||[]),...(D.injuries[g.home]||[])];const outs=all.filter(x=>x.status==="Out").length;
    const qbc=["Away","Home"].some(k=>g["qb"+k]&&g["qb"+k+"Last"]&&norm(g["qb"+k])!==norm(g["qb"+k+"Last"]));
    return `<button class="game" aria-pressed="${state.game===g.id}" data-g="${g.id}">
      <div class="matchup">${g.away} @ ${g.home}</div>
      <div class="meta"><span>${kick(g)}</span>${g.spread!=null?`<span>${spreadTxt(g)}</span>`:""}${g.total?`<span>O/U ${g.total}</span>`:""}</div>
      <div class="envrow">${all.length?`<span class="chip inj">${all.length} on report${outs?` · ${outs} out`:""}</span>`:'<span class="chip g-C">No one on report</span>'}${qbc?'<span class="flag warn">QB change</span>':""}${g.restAway<=5||g.restHome<=5?'<span class="flag">Short week</span>':""}</div></button>`;}).join("");
  const g=GAME[state.game];if(!g){$("#gamedetail").innerHTML="";return;}
  const tracked=D.players.map((p,pi)=>({p,pi})).filter(o=>o.p.game===g.id);
  const playerRow=({p,pi})=>{const best=p.props.map((x,k)=>({k,d:D.defense[p.opp][p.pos+"|"+x.stat]})).filter(o=>o.d).sort((a,b)=>b.d.rank-a.d.rank)[0];
    if(!best)return"";const gr=grade(best.d.rank);
    return `<div class="injrow"><div><button class="linkbtn" data-pi="${pi}" data-ki="${best.k}">${esc(p.name)}</button><div class="sub">${p.pos} · ${p.team} · best: ${esc(p.props[best.k].stat)}</div></div><span class="chip g-${gr}">${gr}</span></div>`;};
  const env=k=>{const t=g[k.toLowerCase()],qb=g["qb"+k],last=g["qb"+k+"Last"];return `<div class="injrow"><div><div class="pname">${NAMES[t]}</div><div class="sub">QB: ${esc(qb||"–")}${qb&&last&&norm(qb)!==norm(last)?` (replacing ${esc(last)})`:""} · ${g["rest"+k]} days rest</div></div><span class="flag">${g["imp"+k]??"–"} pts</span></div>`;};
  $("#gamedetail").innerHTML=`<h2>${NAMES[g.away]} at ${NAMES[g.home]}</h2>
    <div class="sub">${kick(g)}${g.spread!=null?" · "+spreadTxt(g):""}${g.total?" · O/U "+g.total:""}</div>
    <div style="display:flex;flex-wrap:wrap;justify-content:space-between;align-items:end;gap:8px;margin-top:14px"><h3 style="font-family:var(--display);text-transform:uppercase;font-size:22px;margin:0">Players in this game</h3>
      <button class="btn" id="gameprops" data-game="${g.id}">See these props on the Props tab ›</button></div>
    <div class="gplayers">${[g.away,g.home].map(t=>`<div class="panel"><h3>${NAMES[t]}</h3>${gamePlayers(tracked.filter(o=>o.p.team===t))||'<p class="sub">No tracked players.</p>'}</div>`).join("")}</div>
    <div class="gdetail">
    <div class="panel"><h3>Environment</h3>${env("Away")}${env("Home")}
      <div class="envrow" style="margin-top:8px"><span class="flag">${spreadTxt(g)||"No line"}</span>${g.total?`<span class="flag">O/U ${g.total}</span>`:""}${g.roof?`<span class="flag">${g.roof==="dome"||g.roof==="closed"?"Indoors":g.roof==="outdoors"?"Outdoors":esc(g.roof)}</span>`:""}${g.div?'<span class="flag">Division game</span>':""}${g.wind!=null?`<span class="flag ${g.wind>=15?"warn":""}">Wind ${g.wind} mph</span>`:""}</div>
      <p class="sub">Implied points split the total by the spread: the favorite's share is total ÷ 2 + spread ÷ 2.</p></div>
    ${[g.away,g.home].map(t=>`<div class="panel"><details class="ginj"><summary><h3 style="display:inline">${NAMES[t]} injuries</h3> <span class="sub">(${(D.injuries[t]||[]).length}) ›</span></summary>${injList(t)}</details></div>`).join("")}
    </div>`;
}

// ---------- fantasy ----------
const F=(D.fantasy&&D.fantasy.players)||[];const FID=Object.fromEntries(F.map((p,i)=>[p.id,i]));
const FBYNAME=Object.fromEntries(F.map(p=>[`${p.name} (${p.pos}, ${p.team})`,p.id]));
state.myTeam=state.myTeam.filter(id=>FID[id]!==undefined);state.cmp=state.cmp.filter(id=>FID[id]!==undefined);
const fp=id=>F[FID[id]];
const fgrade=p=>p.matchRank?grade(p.matchRank):null;
function oppTxt(p){if(!p.opp)return'<span class="flag">Bye</span>';const g=GAME[p.game];return `${g&&g.home===p.team?"vs":"@"} ${p.opp}`;}
function statusTag(p){return p.status?`<span class="st ${p.status}">${p.status}</span>`:"";}
function fTrend(p){const u=p.opp_log;if(u.length<3)return{cls:"flat",txt:"–"};const a=(u.slice(-2).reduce((x,y)=>x+y,0))/Math.min(2,u.length),prev=u.slice(0,-2),b=prev.reduce((x,y)=>x+y,0)/prev.length;
  const d=b?(a-b)/b:1;const sig=Math.abs(d)>.15&&Math.abs(a-b)>=1.5;const unit=p.pos==="QB"?"att":p.pos==="RB"?"opp":"tgt";
  return{cls:sig?(d>0?"up":"dn"):"flat",txt:`${sig?(d>0?"▲ ":"▼ "):""}${a%1?a.toFixed(1):a} ${unit}`,d};}
function fRow(p,extra=""){const g=fgrade(p);const t=fTrend(p);
  return `<td><button class="linkbtn" data-fid="${esc(p.id)}">${esc(p.name)}</button><div class="sub">${p.pos} · ${p.team} ${oppTxt(p)}</div></td>
  <td class="num"><b>${p.proj}</b></td><td class="num sub">${p.floor}–${p.ceil}</td>
  <td>${g?`<span class="chip g-${g}">${g}</span>`:""}</td><td><span class="trend ${t.cls}">${t.txt}</span></td><td class="num">${p.implied??"–"}</td><td>${statusTag(p)}</td>${extra}`;}
const FHEAD=`<th>Player</th><th class="num">Proj</th><th class="num">Range</th><th>Matchup</th><th>Usage</th><th class="num" title="Team's expected points (for a defense: the opponent's expected points)">Team pts</th><th>Status</th>`;
const SLOTS=[["QB",["QB"]],["RB",["RB"]],["RB",["RB"]],["WR",["WR"]],["WR",["WR"]],["TE",["TE"]],["W/R/T",["WR","RB","TE"]],["K",["K"]],["DEF",["DEF"]]];
function bestLineup(ids){const pool=ids.map(fp).filter(Boolean).sort((a,b)=>b.proj-a.proj);const used=new Set();const out=[];
  for(const [slot,ok] of SLOTS){const p=pool.find(x=>!used.has(x.id)&&ok.includes(x.pos));if(p)used.add(p.id);out.push({slot,p});}
  return{starters:out,bench:pool.filter(x=>!used.has(x.id))};}
function addBox(id,label,btn){return `<div class="addrow"><label for="${id}" class="sub" style="font-weight:600;letter-spacing:.06em;text-transform:uppercase">${label}</label><input type="search" id="${id}" list="fplayers" placeholder="Type a player's name"><button class="btn primary" data-add="${id}">${btn}</button></div>`;}
function renderFantasy(){
  $("#ftitle").textContent=`Fantasy · Week ${D.week} · Half-PPR`;
  document.querySelectorAll("#fnav button").forEach(b=>b.setAttribute("aria-pressed",b.dataset.fv===state.fv));
  const v=state.fv;let h="";
  if(!F.length){$("#fview").innerHTML='<p class="sub">Fantasy data will appear after the next refresh.</p>';return;}
  if(v==="team"){
    h=addBox("addmine","Add to my team","Add");
    if(!state.myTeam.length)h+='<div class="panel"><p class="sub">Your team is empty. Type each player on your Yahoo roster above and tap Add. Overlay saves the list on this device and picks your best lineup every week.</p></div>';
    else{const L=bestLineup(state.myTeam);const total=L.starters.reduce((s,x)=>s+(x.p?.proj||0),0);
      h+=`<div class="tablebox"><table><thead><tr><th>Slot</th>${FHEAD}<th></th></tr></thead><tbody>`+
        L.starters.map(x=>x.p?`<tr><td class="slot">${x.slot}</td>${fRow(x.p,`<td><button class="x" data-rmine="${esc(x.p.id)}" aria-label="Remove">✕</button></td>`)}</tr>`:`<tr><td class="slot">${x.slot}</td><td colspan="8" class="sub">Empty. Add a ${x.slot==="W/R/T"?"WR, RB or TE":x.slot==="DEF"?"team defense (e.g. \"Pittsburgh D/ST\")":x.slot}.</td></tr>`).join("")+
        L.bench.map(p=>`<tr class="bench"><td class="slot">BN</td>${fRow(p,`<td><button class="x" data-rmine="${esc(p.id)}" aria-label="Remove">✕</button></td>`)}</tr>`).join("")+
        `</tbody></table></div><p class="sub" style="margin-top:8px">Suggested starters project <b>${total.toFixed(1)}</b> points. Lineup: QB, 2 RB, 2 WR, TE, W/R/T flex, K and DEF (Yahoo's default). For close calls, open Start / sit.</p>`;}
  }
  if(v==="cmp"){
    h=addBox("addcmp","Compare","Add");
    if(state.myTeam.length)h+=`<p class="sub" style="margin:-4px 0 12px">Or tap from your team: ${state.myTeam.map(fp).filter(Boolean).map(p=>`<button class="linkbtn" data-cmpadd="${esc(p.id)}">${esc(p.name)}</button>`).join(" · ")}</p>`;
    const ps=state.cmp.map(fp).filter(Boolean);
    if(ps.length<2)h+='<div class="panel"><p class="sub">Add two to four players to compare them side by side.</p></div>';
    const best=ps.length?ps.reduce((a,b)=>a.proj>=b.proj?a:b):null;
    if(ps.length){h+=`<div class="cmpgrid">`+ps.map(p=>{const g=fgrade(p),t=fTrend(p);return `<div class="cmpcard ${ps.length>1&&p===best?"win":""}">
      <div style="display:flex;justify-content:space-between;gap:8px"><div style="min-width:0"><button class="linkbtn" data-fid="${esc(p.id)}">${esc(p.name)}</button><div class="sub">${p.pos} · ${p.team} ${oppTxt(p)}</div></div><button class="x" data-rcmp="${esc(p.id)}" aria-label="Remove">✕</button></div>
      <div class="big">${p.proj}</div><div class="sub">Range ${p.floor}–${p.ceil} · season avg ${p.avg}</div>
      <div class="kv"><span>Matchup</span><span>${g?`<span class="chip g-${g}">${g}</span> #${p.matchRank} vs ${p.pos}`:"Bye"}</span></div>
      <div class="kv"><span>Usage</span><span class="trend ${t.cls}">${t.txt}</span></div>
      <div class="kv"><span>Team implied pts</span><span>${p.implied??"–"}</span></div>
      <div class="kv"><span>Status</span><span>${statusTag(p)||"Healthy"}</span></div>
      ${p.teammateOut.length?`<div class="why">Teammate out: ${esc(p.teammateOut.join(", "))}</div>`:""}</div>`;}).join("")+`</div>`;
      if(ps.length>1){const sorted=[...ps].sort((a,b)=>b.proj-a.proj);const gap=sorted[0].proj-sorted[1].proj;const close=gap<1.5;
        h+=`<div class="verdict ${close?"mid":"good"}" style="margin-top:12px"><strong>${close?"Coin flip":"Start "+esc(sorted[0].name)}</strong>${close?`Only ${gap.toFixed(1)} points apart. Go with the higher ceiling (${esc(ps.reduce((a,b)=>a.ceil>=b.ceil?a:b).name)}) if you need a big week, or the higher floor (${esc(ps.reduce((a,b)=>a.floor>=b.floor?a:b).name)}) if you're favored.`:`Projects ${gap.toFixed(1)} points more than ${esc(sorted[1].name)}.`}</div>`;}
    }
  }
  if(v==="rank"){
    h=`<div class="controls"><label for="rpos">Position<select id="rpos"><option value="">All (flex)</option><option>QB</option><option>RB</option><option>WR</option><option>TE</option><option>K</option><option value="DEF">DEF</option></select></label></div>`;
    const list=F.filter(p=>p.opp&&(!state.rpos||p.pos===state.rpos)&&(state.rpos||!["QB","K","DEF"].includes(p.pos))).slice(0,state.rpos==="K"||state.rpos==="DEF"?32:60);
    h+=`<div class="tablebox"><table><thead><tr><th class="num">#</th>${FHEAD}<th></th></tr></thead><tbody>`+list.map((p,i)=>`<tr><td class="num">${i+1}</td>${fRow(p,`<td>${state.myTeam.includes(p.id)?'<span class="sub">On team</span>':`<button class="x" data-addmine="${esc(p.id)}">+ Team</button>`}</td>`)}</tr>`).join("")+`</tbody></table></div>`;
  }
  if(v==="wire"){
    const sl=D.fantasy.sleeper||{};
    const hide=new Set([...state.myTeam,...(state.showRost?[]:state.rostered)]);
    const cand=F.filter(p=>!hide.has(p.id)&&p.opp!==undefined).map(p=>{const t=fTrend(p);const reasons=[];let sc=0;
      if(t.cls==="up"&&p.pos!=="QB"){reasons.push(`Role growing ${t.txt.replace("▲ ","")}`);sc+=Math.min(t.d,1.5)*10;}
      const sn=p.snaps.filter(x=>x!=null);if(sn.length>=3){const a=(sn.at(-1)+sn.at(-2))/2,b=sn.slice(0,-2).reduce((x,y)=>x+y,0)/(sn.length-2);if(a-b>=.12){reasons.push(`Snaps up to ${Math.round(a*100)}%`);sc+=(a-b)*30;}}
      if(p.teammateOut.length&&p.pos!=="QB"){reasons.push(`${p.teammateOut[0]} out`);sc+=6;}
      if(p.adds>=1000){reasons.push(`${p.adds>=1e6?(p.adds/1e6).toFixed(1)+"M":(p.adds/1000).toFixed(p.adds>=10000?0:1)+"k"} Sleeper adds`);sc+=Math.min(12,Math.log10(p.adds)*3);}
      if(p.pos==="QB"&&p.status!=="Out"&&t.cls==="up"&&p.adds>=1000){sc+=2;}
      return{p,reasons,sc};}).filter(x=>x.reasons.length&&x.p.avg<16&&x.p.status!=="Out"&&x.p.pos!=="K"&&x.p.pos!=="DEF").sort((a,b)=>b.sc-a.sc||b.p.proj-a.p.proj).slice(0,30);
    h=`<div class="banner"><b>Yahoo doesn't share roster data with Overlay,</b> so this list can't tell who's already taken in your league. Tap <b>Taken</b> on anyone rostered to hide him. ${sl.ok?"Sleeper adds show who other fantasy players are grabbing this week.":"Sleeper trending adds will appear after the next GitHub refresh."}</div>
      <div class="controls"><label class="chk" for="showrost"><input type="checkbox" id="showrost" ${state.showRost?"checked":""}> Show players I marked taken (${state.rostered.length})</label></div>`;
    h+=cand.length?`<div class="tablebox"><table><thead><tr>${FHEAD}<th>Why</th><th></th></tr></thead><tbody>`+cand.map(x=>`<tr>${fRow(x.p,`<td>${x.reasons.map(r=>`<span class="reason">${esc(r)}</span>`).join("")}</td><td style="white-space:nowrap"><button class="x" data-addmine="${esc(x.p.id)}">+ Team</button> <button class="x" data-taken="${esc(x.p.id)}">${state.rostered.includes(x.p.id)?"Untake":"Taken"}</button></td>`)}</tr>`).join("")+`</tbody></table></div>`
      :'<div class="panel"><p class="sub">No rising players found. Check back after the next refresh.</p></div>';
    for(const pos of ["DEF","K"]){const all=F.filter(p=>p.pos===pos&&p.opp);const st=all.filter(p=>!hide.has(p.id)).slice(0,6);
      if(!st.length)continue;
      h+=`<h3 style="font-family:var(--display);text-transform:uppercase;font-size:20px;margin:22px 0 4px">Streaming ${pos==="DEF"?"defenses":"kickers"}</h3><p class="sub" style="margin:0 0 8px">Best projected ${pos==="DEF"?"defenses":"kickers"} this week that you haven't marked taken. Swap one in each week based on matchup.</p>`+
      `<div class="tablebox"><table><thead><tr><th class="num">#</th>${FHEAD}<th></th></tr></thead><tbody>`+st.map(p=>`<tr><td class="num">${all.indexOf(p)+1}</td>${fRow(p,`<td style="white-space:nowrap"><button class="x" data-addmine="${esc(p.id)}">+ Team</button> <button class="x" data-taken="${esc(p.id)}">${state.rostered.includes(p.id)?"Untake":"Taken"}</button></td>`)}</tr>`).join("")+`</tbody></table></div>`;}
  }
  $("#fview").innerHTML=h;
  const rp=$("#rpos");if(rp){rp.value=state.rpos;rp.onchange=e=>{state.rpos=e.target.value;save();renderFantasy();};}
  const sr=$("#showrost");if(sr)sr.onchange=e=>{state.showRost=e.target.checked;save();renderFantasy();};
  document.querySelectorAll("#fview input[list]").forEach(i=>i.addEventListener("keydown",e=>{if(e.key==="Enter")document.querySelector(`[data-add="${i.id}"]`).click();}));
}
function addFromBox(boxId){const i=$("#"+boxId);const id=FBYNAME[i.value]||(F.find(p=>p.name.toLowerCase()===i.value.trim().toLowerCase())||{}).id;
  if(!id){toast("Pick a name from the list");return;}
  if(boxId==="addmine"){if(!state.myTeam.includes(id))state.myTeam.push(id);toast(`Added ${fp(id).name}`);}
  else{if(state.cmp.length>=4){toast("Compare up to 4 players");return;}if(!state.cmp.includes(id))state.cmp.push(id);}
  save();renderFantasy();const n=$("#"+boxId);if(n)n.focus();}
function openFantasy(id){const p=fp(id);if(!p)return;const g=fgrade(p);const t=fTrend(p);
  const pi=PID[p.id];const propLink=pi!==undefined?`<button class="btn" data-pi="${pi}" data-ki="0" data-switch="1">Open prop view</button>`:"";
  const isKD=p.pos==="K"||p.pos==="DEF";
  const usage=p.opp_log.map((u,i)=>`<tr><td>Wk ${p.log[i]?.wk??"–"}</td><td>${pctf(p.snaps[i])}</td><td>${u}</td><td>${p.log[i]?.v??"–"}</td></tr>`).join("");
  $("#sheet").innerHTML=`<div class="sheethead"><div><h2>${esc(p.name)}</h2><div class="sub">${p.pos} · ${NAMES[p.team]||p.team} ${p.opp?(GAME[p.game]?.home===p.team?"vs ":"@ ")+NAMES[p.opp]+" · "+kick(GAME[p.game]):"· Bye week"}</div></div><button class="close" id="closebtn">Close</button></div>
   ${p.status?`<p>${statusTag(p)} on the latest injury report.</p>`:""}
   <div class="stats"><div class="stat"><span>${isKD?"Projection":"Half-PPR proj"}</span><b>${p.proj}</b></div><div class="stat"><span>Range</span><b>${p.floor}–${p.ceil}</b></div><div class="stat"><span>Season avg</span><b>${p.avg}</b></div></div>
   ${p.opp?`<div class="verdict ${g==="A"||g==="B"?"good":g==="C"?"mid":"bad"}"><strong>${g} fantasy matchup</strong>${p.pos==="DEF"?`${NAMES[p.opp]}'s offense gives up ${p.matchAllowed} fantasy points a game to opposing defenses (rank ${p.matchRank} of 32, where 32 gives up the most). ${NAMES[p.opp]} is expected to score ${p.implied??"–"} points.`:p.pos==="K"?`${NAMES[p.opp]} allows ${p.matchAllowed} kicker points a game (rank ${p.matchRank} of 32, where 32 allows the most). ${NAMES[p.team]} is expected to score ${p.implied??"–"} points.`:`${NAMES[p.opp]} allows ${p.matchAllowed} half-PPR points a game to ${p.pos}s (rank ${p.matchRank} of 32, where 32 allows the most; league average ${D.fantasy.leagueAllowed[p.pos]}). ${NAMES[p.team]} is expected to score ${p.implied??"–"} points.`}</div>`:""}
   <div class="sec">${isKD?"Fantasy":"Half-PPR"} points by game</div>${bars(p.log.slice(-6),p.avg,"Season avg "+p.avg,"Fantasy points by game")}
   ${isKD?`<div class="sec">Game by game</div><div style="overflow-x:auto"><table class="mini"><thead><tr><th>Game</th><th>${p.pos==="K"?"Kicks":"Defense"}</th><th>Points</th></tr></thead><tbody>${(p.breakdown||[]).map((b,i)=>`<tr><td>Wk ${b.wk}</td><td>${esc(b.txt)}</td><td>${p.log[i]?.v??"–"}</td></tr>`).join("")}</tbody></table></div>`
     :`<div class="sec">Usage by game</div><div style="overflow-x:auto"><table class="mini"><thead><tr><th>Game</th><th>Snaps</th><th>${p.pos==="QB"?"Pass att":p.pos==="RB"?"Carries + targets":"Targets"}</th><th>Points</th></tr></thead><tbody>${usage}</tbody></table></div>`}
   ${p.teammateOut.length?`<div class="sec">Teammates out</div><p class="sub">${esc(p.teammateOut.join(", "))} ${p.teammateOut.length>1?"are":"is"} out, which can open up work for ${esc(p.name)}.</p>`:""}
   ${p.adds||p.drops?`<div class="sec">Sleeper, last 48 hours</div><p class="sub">${p.adds.toLocaleString()} adds · ${p.drops.toLocaleString()} drops</p>`:""}
   <div style="display:flex;gap:8px;flex-wrap:wrap;margin-top:16px">${state.myTeam.includes(p.id)?"":`<button class="btn primary" data-addmine="${esc(p.id)}">Add to my team</button>`}<button class="btn" data-cmpadd="${esc(p.id)}">Compare</button>${propLink}</div>`;
  $("#sheet").hidden=false;$("#scrim").hidden=false;$("#sheet").scrollTop=0;$("#closebtn").onclick=closeSheet;$("#closebtn").focus();}
$("#fplayers").innerHTML=F.map(p=>`<option value="${esc(`${p.name} (${p.pos}, ${p.team})`)}"></option>`).join("");
$("#fnav").addEventListener("click",e=>{const b=e.target.closest("button[data-fv]");if(b){state.fv=b.dataset.fv;save();renderFantasy();}});

// ---------- pick'em ----------
const PK=D.pickem||[];
function etDate(day,time){const [y,m,d]=day.split("-").map(Number);
  const nthSun=(mo,n)=>{const f=new Date(Date.UTC(y,mo-1,1)).getUTCDay();return 1+((7-f)%7)+7*(n-1);};
  const dst=(m>3&&m<11)||(m===3&&d>=nthSun(3,2))||(m===11&&d<nthSun(11,1));
  return new Date(`${day}T${time}:00${dst?"-04:00":"-05:00"}`);}
function pkProb(g){if(g.mlA!=null&&g.mlH!=null){const a=imp(g.mlA),h=imp(g.mlH);return h/(a+h);}
  if(g.spread!=null)return cdf(g.spread/13.5);return .5;} // home win chance
const PK_WEEKS=[...new Set(PK.map(g=>g.week))].sort((a,b)=>a-b);
function pkDefaultWeek(){const now=new Date();for(const w of PK_WEEKS){const first=PK.filter(g=>g.week===w).map(g=>etDate(g.day,g.time)).sort((a,b)=>a-b)[0];if(first>now)return w;}return PK_WEEKS[PK_WEEKS.length-1];}
if(!PK_WEEKS.includes(state.pkWeek))state.pkWeek=pkDefaultWeek();
if(!state.pkN)state.pkN=26;
state.pk=state.pk||{};
const poolFromSlider=v=>Math.round(Math.exp(Math.log(2)+(Math.log(1000)-Math.log(2))*v/100));
const sliderFromPool=n=>Math.round(100*(Math.log(n)-Math.log(2))/(Math.log(1000)-Math.log(2)));
// seeded random so results are stable between renders
function mulberry(a){return()=>{a|=0;a=a+0x6D2B79F5|0;let t=Math.imul(a^a>>>15,1|a);t=t+Math.imul(t^t>>>7,61|t)^t;return((t^t>>>14)>>>0)/4294967296;};}
let pkSims=null,pkSimKey="";
function pkSetup(games){const key=games.map(g=>g.id).join(",");if(pkSimKey===key)return;pkSimKey=key;
  const r=mulberry(12345),S=3000;pkSims=[];for(let i=0;i<S;i++)pkSims.push(games.map(g=>r()<pkProb(g)?1:0));} // 1 = home won
// chance our picks finish first (ties split) against n-1 others who pick favorites a bit too often
function pkWinChance(games,picks,n){
  const q=games.map(g=>{const p=pkProb(g),k=1.6;return Math.pow(p,k)/(Math.pow(p,k)+Math.pow(1-p,k));}); // share of others picking home
  let tot=0;const G=games.length;
  for(const out of pkSims){let ours=0;const dist=new Float64Array(G+1);dist[0]=1;
    for(let i=0;i<G;i++){const hw=out[i]===1;if((picks[i]===1)===hw)ours++;const pc=hw?q[i]:1-q[i];
      for(let s=i+1;s>=1;s--)dist[s]=dist[s]*(1-pc)+dist[s-1]*pc;dist[0]*=(1-pc);}
    let F1=0;for(let s=0;s<ours;s++)F1+=dist[s];const f=dist[ours],F=F1+f;
    tot+=n<=1?1:(f>1e-12?(Math.pow(F,n)-Math.pow(F1,n))/(n*f):Math.pow(F1,n-1));}
  return tot/pkSims.length;}
function pkOptimize(games,n){const fav=games.map(g=>pkProb(g)>=.5?1:0);let best=fav.slice(),bestW=pkWinChance(games,best,n);
  for(let round=0;round<6;round++){let imp=null;
    for(let i=0;i<games.length;i++){const p=pkProb(games[i]);if(Math.max(p,1-p)>.78||best[i]!==fav[i])continue;
      const t=best.slice();t[i]=1-t[i];const w=pkWinChance(games,t,n);if(w>bestW*1.01&&(!imp||w>imp.w))imp={i,w};}
    if(!imp)break;best[imp.i]=1-best[imp.i];bestW=imp.w;}
  return{picks:best,w:bestW,favW:pkWinChance(games,fav,n)};}
let pkTimer=null;
const pctTxt=x=>x<.001?"<0.1%":(x*100).toFixed(x<.1?1:0)+"%";
function renderPickem(){
  const w=state.pkWeek;const games=PK.filter(g=>g.week===w);
  $("#pktitle").textContent=`Week ${w} pick'em`;
  if(!games.length){$("#pkview").innerHTML='<p class="sub">No games found for this week yet.</p>';return;}
  pkSetup(games);const n=state.pkN;
  const opt=pkOptimize(games,n);
  const saved=state.pk[w]||{};const picks=games.map((g,i)=>saved[g.id]!=null?saved[g.id]:opt.picks[i]);
  const winNow=pkWinChance(games,picks,n);const exp=games.reduce((s,g,i)=>s+(picks[i]?pkProb(g):1-pkProb(g)),0);
  const upsets=games.filter((g,i)=>(picks[i]===1)!==(pkProb(g)>=.5)).length;
  const last=[...games].sort((a,b)=>etDate(a.day,a.time)-etDate(b.day,b.time)).at(-1);
  const now=new Date();
  const changed=Object.keys(saved).length>0;
  const weekBtns=PK_WEEKS.map(x=>`<button data-pkw="${x}" aria-pressed="${x===w}">Week ${x}</button>`).join("");
  let h=`<div class="pkbar"><div class="subnav" style="margin:0">${weekBtns}</div>
    <label for="pkpool">People in your pool: <span class="rv" id="pkn">${n}</span><input type="range" id="pkpool" min="0" max="100" value="${sliderFromPool(n)}"></label>
    ${changed?'<button class="btn" id="pkreset">Reset to recommended</button>':""}<button class="btn" id="pkcopy">Copy picks</button></div>
    <div class="pksum"><div><span>Expected correct</span><b>${exp.toFixed(1)} / ${games.length}</b></div>
      <div><span>Chance to win your pool</span><b>${pctTxt(winNow)}</b><span style="text-transform:none;letter-spacing:0">all favorites: ${pctTxt(opt.favW)} · random pick: ${pctTxt(1/n)}</span></div>
      <div><span>Upset picks</span><b>${upsets}</b></div>
      <div><span>Tiebreaker · ${last.away} @ ${last.home}</span><b>${last.total!=null?Math.round(last.total):"–"} pts</b></div></div>
    <div class="pklist">`;
  h+=games.map((g,i)=>{const ph=pkProb(g),pa=1-ph;const started=etDate(g.day,g.time)<=now;const fin=g.scoreA!=null&&g.scoreH!=null;
    const pick=picks[i];const isUpset=(pick===1)!==(ph>=.5);
    const qbc=(t)=>{const now_=t==="A"?g.qbA:g.qbH,last_=t==="A"?g.qbALast:g.qbHLast;return now_&&last_&&norm(now_)!==norm(last_)?`<span class="flag warn">QB: ${esc(now_)}</span>`:"";};
    const team=(side)=>{const isH=side==="H",t=isH?g.home:g.away,p=isH?ph:pa,ml=isH?g.mlH:g.mlA,sel=(pick===1)===isH;
      const res=fin?((isH?g.scoreH>g.scoreA:g.scoreA>g.scoreH)?'<span class="won">W</span>':'<span class="lost">L</span>'):"";
      return `<button class="pkteam" data-pkg="${g.id}" data-side="${isH?1:0}" aria-pressed="${sel}" ${started?"disabled":""}>
        <span class="tn"><span>${t} <span class="sm" style="font-family:var(--body);text-transform:none;font-weight:400">${isH?"home":"away"}</span></span><span>${res||(sel?"✓":"")}</span></span>
        <span class="pkbarw"><i style="width:${Math.round(p*100)}%"></i></span>
        <span class="sm">${Math.round(p*100)}% to win${ml!=null?` · ${fmtOdds(ml)}`:""}${fin?` · ${isH?g.scoreH:g.scoreA}`:""}</span>${qbc(isH?"H":"A")}</button>`;};
    return `<div class="pkgame">${team("A")}${team("H")}<div class="meta2"><span>${kick(g)}${g.spread!=null?" · "+spreadTxt(g):""}</span>${isUpset?'<span class="upset">Upset pick</span>':""}${started&&!fin?'<span class="sub">Locked</span>':""}</div></div>`;}).join("")+`</div>`;
  $("#pkview").innerHTML=h;
  $("#pkpool").oninput=e=>{const v=poolFromSlider(+e.target.value);$("#pkn").textContent=v;clearTimeout(pkTimer);pkTimer=setTimeout(()=>{state.pkN=v;save();renderPickem();},250);};
  const rs=$("#pkreset");if(rs)rs.onclick=()=>{delete state.pk[w];save();renderPickem();};
  $("#pkcopy").onclick=()=>{const txt=`Week ${w} picks: `+games.map((g,i)=>picks[i]?g.home:g.away).join(", ")+(last.total!=null?`\nTiebreaker (${last.away} @ ${last.home}): ${Math.round(last.total)}`:"");
    (navigator.clipboard?.writeText(txt)||Promise.reject()).then(()=>toast("Picks copied"),()=>toast("Copy not allowed here"));};
}
document.addEventListener("click",e=>{
  const wb=e.target.closest("[data-pkw]");if(wb){state.pkWeek=+wb.dataset.pkw;save();renderPickem();return;}
  const tb=e.target.closest(".pkteam");if(tb&&!tb.disabled){const w=state.pkWeek,games=PK.filter(g=>g.week===w);pkSetup(games);
    const opt=pkOptimize(games,state.pkN);const i=games.findIndex(g=>g.id===tb.dataset.pkg);const v=+tb.dataset.side;
    state.pk[w]=state.pk[w]||{};if(opt.picks[i]===v)delete state.pk[w][tb.dataset.pkg];else state.pk[w][tb.dataset.pkg]=v;
    if(!Object.keys(state.pk[w]).length)delete state.pk[w];save();renderPickem();}
});

// ---------- wiring ----------
$("#weeklabel").textContent=`NFL · WEEK ${D.week}`;
const injWeek=Math.max(0,...Object.values(D.injuries).flat().map(x=>x.week));
$("#freshness").textContent=`Stats thru Wk ${D.statsThrough}`;$("#freshness").style.color="var(--muted)";$("#freshness").style.background="var(--raised)";
$("#matchtitle").textContent=`Week ${D.week} props`;
const oddsAt=D.odds&&D.odds.fetched?new Date(D.odds.fetched).toLocaleString("en-US",{weekday:"short",hour:"numeric",minute:"2-digit"}):null;
$("#linesbanner").innerHTML=HAS_LINES?`<b>PrizePicks lines as of ${oddsAt||"the last refresh"}.</b> Green hit chance = beats your slip's <span id="bepct">${(state.be*100).toFixed(0)}%</span> break-even. New lines arrive Thursday and Saturday mornings; double-check any line in the app before you play it.`:
 `<b>Live PrizePicks lines aren't connected yet.</b> Open a player and type in the line from the app to check it.${injWeek<D.week?` Injury statuses are from the Week ${injWeek} report until Week ${D.week} reports come out midweek.`:""}`;
$("#sliplabel").hidden=!HAS_LINES;
if(D.odds&&D.odds.remaining!=null)$("#credits").textContent=`Odds credits left: ${D.odds.remaining}.`;
$("#updated").textContent="Updated "+new Date(D.generated).toLocaleString("en-US",{weekday:"short",month:"short",day:"numeric",hour:"numeric",minute:"2-digit"})+".";
if(!state.tipDone)$("#tip").hidden=false;
$("#tipclose").onclick=()=>{state.tipDone=true;save();$("#tip").hidden=true;};
$("#ftoggle").onclick=()=>{const o=$("#filters").classList.toggle("open");$("#ftoggle").setAttribute("aria-expanded",o);};
const TABS=["match","slip","fantasy","pickem","defense","games"];
function setTab(t){if(!TABS.includes(t))t="match";state.tab=t;save();document.querySelectorAll("nav.tabs button").forEach(b=>b.setAttribute("aria-selected",b.dataset.tab===t));TABS.forEach(id=>$("#"+id).hidden=id!==t);}
document.querySelectorAll("nav.tabs button").forEach(b=>b.onclick=()=>setTab(b.dataset.tab));
[...new Set(ROWS.map(r=>r.pr.stat))].forEach(m=>$("#mkt").insertAdjacentHTML("beforeend",`<option>${m}</option>`));
D.games.forEach(g=>$("#gm").insertAdjacentHTML("beforeend",`<option value="${g.id}">${g.away} @ ${g.home}</option>`));
for(const k of["pos","mkt","gm","grd"]){$("#"+k).value=state[k];$("#"+k).onchange=e=>{state[k]=e.target.value;save();renderMatch();};}
$("#moved").checked=!!state.moved;$("#moved").onchange=e=>{state.moved=e.target.checked;save();renderMatch();};
$("#wonly").checked=state.wonly;$("#wonly").onchange=e=>{state.wonly=e.target.checked;save();renderMatch();};
$("#sliptype").value=String(state.be);$("#sliptype").onchange=e=>{state.be=+e.target.value;save();renderMatch();const b=$("#bepct");if(b)b.textContent=(state.be*100).toFixed(0)+"%";};
$("#q").oninput=e=>{state.q=e.target.value;renderMatch();};
document.addEventListener("click",e=>{
  const st=e.target.closest(".star");if(st){e.stopPropagation();toggleWatch(st.dataset.w);return;}
  const fb=e.target.closest("[data-fid]");if(fb){openFantasy(fb.dataset.fid);return;}
  const ad=e.target.closest("[data-add]");if(ad){addFromBox(ad.dataset.add);return;}
  const am=e.target.closest("[data-addmine]");if(am){const id=am.dataset.addmine;if(!state.myTeam.includes(id))state.myTeam.push(id);save();renderFantasy();toast(`Added ${fp(id).name} to your team`);if(!$("#sheet").hidden)openFantasy(id);return;}
  const rmn=e.target.closest("[data-rmine]");if(rmn){state.myTeam=state.myTeam.filter(x=>x!==rmn.dataset.rmine);save();renderFantasy();return;}
  const ca=e.target.closest("[data-cmpadd]");if(ca){const id=ca.dataset.cmpadd;if(!state.cmp.includes(id)){if(state.cmp.length>=4){toast("Compare up to 4 players");return;}state.cmp.push(id);}state.fv="cmp";save();renderFantasy();if(!$("#sheet").hidden){closeSheet();setTab("fantasy");}toast(`Comparing ${state.cmp.length} player${state.cmp.length>1?"s":""}`);return;}
  const rc=e.target.closest("[data-rcmp]");if(rc){state.cmp=state.cmp.filter(x=>x!==rc.dataset.rcmp);save();renderFantasy();return;}
  const tk=e.target.closest("[data-taken]");if(tk){const id=tk.dataset.taken;state.rostered=state.rostered.includes(id)?state.rostered.filter(x=>x!==id):[...state.rostered,id];save();renderFantasy();return;}
  const rm=e.target.closest("[data-rm]");if(rm){state.legs.splice(+rm.dataset.rm,1);save();renderSlip();return;}
  const t=e.target.closest("tr.click,.pcard,.linkbtn,.propchip,[data-switch]");if(t&&t.dataset.pi!==undefined){openPlayer(+t.dataset.pi,+t.dataset.ki);return;}
  const gp=e.target.closest("#gameprops");if(gp){state.gm=gp.dataset.game;$("#gm").value=state.gm;save();renderMatch();setTab("match");window.scrollTo(0,0);return;}
  const g=e.target.closest(".game");if(g){state.game=g.dataset.g;save();renderGames();const gd=$("#gamedetail");if(gd)gd.scrollIntoView({block:"start"});}
});
for(const id of ["#matchbody","#matchcards"])$(id).addEventListener("keydown",e=>{if(e.key==="Enter"||e.key===" "){const r=e.target.closest("tr.click,.pcard");if(r&&e.target===r){e.preventDefault();state.tipDone=true;save();$("#tip").hidden=true;openPlayer(+r.dataset.pi,+r.dataset.ki);}}});
renderMatch();renderSlip();renderFantasy();renderPickem();renderHeat();renderGames();setTab(state.tab);
</script>
