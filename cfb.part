<style>
.cfbf{display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin:0 0 14px}
.cfbf select{font:inherit;padding:7px 10px;border-radius:6px;border:1px solid var(--line);background:var(--surface);color:var(--fg)}
.rk{font-family:var(--mono);font-size:11px;color:var(--muted)}
.trank{font-family:var(--mono);font-size:11px;font-weight:600;color:var(--muted);margin-right:2px}
.lastg{display:flex;gap:4px;flex-wrap:wrap}
.lastg span{font-family:var(--mono);font-size:11px;padding:2px 6px;border-radius:4px;background:var(--raised)}
.lastg span.W{color:var(--pos)} .lastg span.L{color:var(--neg)}
table.rt td,table.rt th{white-space:nowrap}
.statrow2{display:flex;justify-content:space-between;align-items:center;gap:10px;border-top:1px solid var(--line);padding:8px 0}
.statrow2:first-child{border-top:0}
.statrow2 .sname{all:unset;cursor:pointer;display:flex;flex-direction:column;gap:2px;min-width:0}
.statrow2 .sname:hover b{text-decoration:underline}
.statrow2 .sname:focus-visible{outline:2px solid var(--accent);outline-offset:2px;border-radius:4px}
.statrow2 .pv{font-family:var(--mono);color:var(--fg)}
.lin{display:flex;flex-direction:column;align-items:flex-end;gap:4px;flex:none}
.lin input{width:76px;font:inherit;font-family:var(--mono);padding:6px 8px;border-radius:6px;border:1px solid var(--line);background:var(--bg);color:var(--fg);text-align:right}
.lin .res{display:flex;gap:4px;align-items:center;min-height:0}
.lin .res:empty{display:none}
#mine{margin:0 0 14px}
.mrow{all:unset;box-sizing:border-box;cursor:pointer;display:flex;width:100%;justify-content:space-between;align-items:center;gap:10px;padding:8px 0;border-top:1px solid var(--line)}
.mrow:hover b{text-decoration:underline}
.linkbtn{all:unset;cursor:pointer;color:var(--accent);font-size:12px;text-transform:none;letter-spacing:0}
.statrow{display:flex;width:100%;justify-content:space-between;align-items:center;gap:10px;text-align:left;background:none;border:0;border-top:1px solid var(--line);font:inherit;color:inherit;cursor:pointer;padding:9px 0}
.statrow:first-child{border-top:0}
.statrow .r{display:flex;gap:8px;align-items:center;flex-shrink:0}
.statrow:hover b{text-decoration:underline}
</style>
<header class="top">
  <div class="topin">
    <div class="brand">Over<span>lay</span></div>
    <nav class="sport" aria-label="Sport"><a href="./">Today</a><a href="nfl.html">NFL</a><a href="nba.html">NBA</a><a href="cfb.html" aria-current="page">CFB</a></nav>
    <div class="week" id="weeklabel"></div>
  </div>
  <nav class="tabs" role="tablist">
    <button role="tab" aria-selected="true" data-tab="games">Games</button>
    <button role="tab" aria-selected="false" data-tab="props">Props</button>
    <button role="tab" aria-selected="false" data-tab="ratings">Ratings</button>
  </nav>
</header>

<main class="wrap">
  <section id="games">
    <h2>College football</h2>
    <p class="lede">This week's FBS games with DraftKings lines. Tap a game for both teams' numbers, line movement and Overlay's rough take.</p>
    <div class="cfbf"><select id="cf" aria-label="Which games"><option value="top">Top 25 games</option><option value="all">All games</option></select><select id="conf" aria-label="Conference"><option value="">Any conference</option></select></div>
    <div id="gamelist"></div>
    <div id="gamedetail"></div>
    <details class="info"><summary>How to read this</summary>
      <p><b>Win chance</b> comes from DraftKings' moneylines with the fee removed. It's the market's number, not ours.</p>
      <p><b>Overlay's rough number</b> rates every FBS team from this season's scores, adjusted for who they played and home field. It doesn't know about injuries, weather or who's starting at quarterback. In a backtest on weeks 4–9 it was about a coin flip against DraftKings' spreads, so leans are shown for context and tracked on the Today page, not offered as edges.</p></details>
  </section>
  <section id="props" hidden>
    <h2>Player props</h2>
    <div class="banner"><b>Type the PrizePicks line in the box next to any stat</b> and Overlay shows which side it likes and its chance to hit. 54% or better (green) is what a 6-pick Flex needs. Every line you enter collects in a "Your lines" list, best first. <span class="sub">Proj is Overlay's projection; the +/− is how it compares with his season average after adjusting for this defense.</span></div>
    <div class="panel" id="mine" hidden></div>
    <div class="cfbf"><select id="pgame" aria-label="Game"><option value="">All Top 25 games</option></select><select id="ppos" aria-label="Position"><option value="">All positions</option><option>QB</option><option>RB</option><option>WR/TE</option></select></div>
    <div id="plist"></div>
    <p class="sub">Players on teams in this week's Top 25 games that haven't kicked off yet. Projections weight recent games more and adjust for how much the opponent allows, shrunk halfway toward average since college schedules vary so much.</p>
  </section>
  <section id="ratings" hidden>
    <h2>Power ratings</h2>
    <p class="lede">Overlay's rating of every FBS team from this season's scores, adjusted for opponents. The number is roughly points better than an average FBS team on a neutral field.</p>
    <div class="tablebox"><table class="rt"><thead><tr><th>#</th><th>Team</th><th class="num">Rating</th><th class="num">Record</th><th class="num">PPG</th><th class="num">Allowed</th><th class="num">Schedule</th></tr></thead><tbody id="rtbody"></tbody></table></div>
  </section>
</main>
<footer class="wrap" style="padding-block:0 32px"><p class="note"><span id="updated"></span> Data: ESPN (scores, rankings, DraftKings lines). Free; no odds credits used. For entertainment and research only. Bet responsibly.</p></footer>
<div class="toast" id="toast" hidden></div>
<div class="scrim" id="scrim" hidden></div>
<aside class="sheet" id="sheet" hidden aria-label="Player detail"></aside>

<script id="data" type="application/json">__DATA__</script>
<script>
const D=JSON.parse(document.getElementById("data").textContent);
const $=s=>document.querySelector(s);
const esc=t=>String(t??"").replace(/[&<>"]/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c]));
const pct=x=>x==null?"–":Math.round(x*100)+"%";
const fmtOdds=o=>o==null?"–":(o>0?"+"+o:String(o));
const sgn=x=>(x>0?"+":"")+x;
const logo=(t,s=22)=>t&&t.logo?`<img class="logo" src="${esc(t.logo)}" alt="" width="${s}" height="${s}" loading="lazy" onerror="this.remove()">`:"";
const tname=t=>`${t.rank?`<span class="trank">${t.rank}</span>`:""}${esc(t.name)}`;
const when=iso=>new Date(iso).toLocaleString("en-US",{weekday:"short",hour:"numeric",minute:"2-digit"});
const GAME=Object.fromEntries(D.games.map(g=>[g.id,g]));
let state={cf:"top",conf:"",game:null,tab:"games"};try{Object.assign(state,JSON.parse(localStorage.getItem("overlay-cfb-v1")||"{}"));}catch(e){}
const save=()=>{try{localStorage.setItem("overlay-cfb-v1",JSON.stringify(state));}catch(e){}};
$("#weeklabel").textContent=`WEEK ${D.week}`;
$("#updated").textContent="Updated "+new Date(D.generated).toLocaleString("en-US",{weekday:"short",hour:"numeric",minute:"2-digit"})+".";
const confs=[...new Set(D.games.flatMap(g=>[g.home.conf,g.away.conf]).filter(Boolean))].sort();
confs.forEach(c=>$("#conf").insertAdjacentHTML("beforeend",`<option>${esc(c)}</option>`));
$("#cf").value=state.cf;$("#conf").value=state.conf;
$("#cf").onchange=e=>{state.cf=e.target.value;save();renderGames();};$("#conf").onchange=e=>{state.conf=e.target.value;save();renderGames();};

function spreadTxt(g){const o=g.odds;if(!o||o.spreadH==null)return"";return o.spreadH<=0?`${g.home.abbr} ${o.spreadH===0?"PK":o.spreadH}`:`${g.away.abbr} -${o.spreadH}`;}
function list(){return D.games.filter(g=>(state.cf==="all"||g.home.rank||g.away.rank)&&(!state.conf||g.home.conf===state.conf||g.away.conf===state.conf));}
function renderGames(){const L=list();const days=[...new Set(L.map(g=>g.day))];
  if(!L.length){$("#gamelist").innerHTML='<div class="panel"><p class="sub">No games match. Try "All games".</p></div>';$("#gamedetail").innerHTML="";return;}
  $("#gamelist").innerHTML=days.map(day=>`<div class="daygroup">${new Date(day+"T12:00:00").toLocaleDateString("en-US",{weekday:"long",month:"short",day:"numeric"})}</div><div class="gm-cards">`+L.filter(g=>g.day===day).map(g=>{const o=g.odds,fin=g.state==="post",live=g.state==="in";
    return `<button class="game" aria-pressed="${state.game===g.id}" data-g="${g.id}">
      <div class="matchup">${logo(g.away)} ${tname(g.away)} ${g.neutral?"vs":"@"} ${logo(g.home)} ${tname(g.home)}</div>
      <div class="meta"><span>${fin||live?esc(g.detail):when(g.start)}${g.tv?` · ${esc(g.tv)}`:""}</span>${o&&o.spreadH!=null?`<span>${spreadTxt(g)}</span>`:""}${o&&o.total!=null?`<span>O/U ${o.total}</span>`:""}</div>
      ${fin||live?`<div class="meta"><span><b>${g.away.abbr} ${g.scoreA} · ${g.home.abbr} ${g.scoreH}</b></span></div>`:g.pH!=null?`<div class="meta"><span>${g.pH>=.5?g.home.abbr:g.away.abbr} ${Math.max(g.pH,1-g.pH)>.99?">99%":pct(Math.max(g.pH,1-g.pH))} to win</span></div>`:`<div class="meta"><span>Lines not posted</span></div>`}
      ${g.wx&&g.wx.flag&&!fin?`<div class="envrow"><span class="chip inj" title="Kickoff forecast">${esc(g.wx.flag)}</span></div>`:""}
      ${g.leans.length&&!fin?`<div class="envrow">${g.leans.map(l=>`<span class="chip">Lean ${l.type==="spread"?`${l.team} ${sgn(l.line)}`:`${l.side} ${l.line}`}</span>`).join("")}</div>`:""}
    </button>`;}).join("")+"</div>").join("");
  const g=GAME[state.game];$("#gamedetail").innerHTML=g&&L.includes(g)?detail(g):"";}
function detail(g){const H=D.teams[g.home.id]||{},A=D.teams[g.away.id]||{},o=g.odds,m=g.model;
  const row=(label,k,hiGood=true,rk)=>{const a=A[k],h=H[k];if(a==null||h==null)return"";const b=hiGood?(a>h?"A":h>a?"H":""):(a<h?"A":h<a?"H":"");
    return `<tr><td>${label}</td><td class="v ${b==="A"?"better":""}">${a}${rk&&A[rk]?` <span class="rk">#${A[rk]}</span>`:""}</td><td class="v ${b==="H"?"better":""}">${h}${rk&&H[rk]?` <span class="rk">#${H[rk]}</span>`:""}</td></tr>`;};
  const last=t=>(t.last||[]).map(x=>`<span class="${x.res}" title="Week ${x.w}">${x.res} ${x.home===false?"@":x.home===null?"vs":""}${esc(x.opp)} ${x.pf}-${x.pa}</span>`).join("");
  const why=[];
  if(H.offRank&&A.defRank){why.push(`<b>${g.home.abbr} offense (#${H.offRank}) vs ${g.away.abbr} defense (#${A.defRank}).</b>`);why.push(`<b>${g.away.abbr} offense (#${A.offRank}) vs ${g.home.abbr} defense (#${H.defRank}).</b> Ranks are out of ${H.of} FBS teams, adjusted for opponents.`);}
  if(H.sosRank&&A.sosRank&&Math.abs(H.sosRank-A.sosRank)>=40){const tough=H.sosRank<A.sosRank?g.home:g.away,soft=tough===g.home?g.away:g.home;why.push(`<b>Schedules differ a lot:</b> ${tough.abbr} has played the #${Math.min(H.sosRank,A.sosRank)} toughest schedule, ${soft.abbr} the #${Math.max(H.sosRank,A.sosRank)}. Records can mislead here.`);}
  if(o&&o.spreadHOpen!=null&&o.spreadH!=null&&o.spreadHOpen!==o.spreadH){const toward=o.spreadH<o.spreadHOpen?g.home.abbr:g.away.abbr;why.push(`<b>Line movement:</b> ${g.home.abbr} ${sgn(o.spreadHOpen)} → ${sgn(o.spreadH)}, money coming in on <b>${toward}</b>.`);}
  if(o&&o.totalOpen!=null&&o.total!=null&&o.totalOpen!==o.total)why.push(`<b>Total moved</b> from ${o.totalOpen} to ${o.total}.`);
  if(g.neutral)why.push("<b>Neutral site</b>, so no home-field edge.");
  const bets=o?`<div class="panel" style="margin-top:12px"><h3>Lines · ${esc(o.book)}</h3><table class="mini"><thead><tr><th></th><th>${esc(g.away.abbr)}</th><th>${esc(g.home.abbr)}</th></tr></thead><tbody>
    ${o.spreadH!=null?`<tr><td>Spread</td><td>${sgn(-o.spreadH)} (${fmtOdds(o.spreadAOdds)})</td><td>${sgn(o.spreadH)} (${fmtOdds(o.spreadHOdds)})</td></tr>`:""}
    ${o.mlH!=null?`<tr><td>Moneyline</td><td>${fmtOdds(o.mlA)}</td><td>${fmtOdds(o.mlH)}</td></tr><tr><td>Win chance</td><td>${pct(1-g.pH)}</td><td>${pct(g.pH)}</td></tr>`:""}
    ${o.total!=null?`<tr><td>Total</td><td colspan="2">${o.total} (Over ${fmtOdds(o.overOdds)} / Under ${fmtOdds(o.underOdds)})</td></tr>`:""}</tbody></table></div>`:"";
  const mk=o&&o.spreadH!=null?-o.spreadH:null;
  const take=`<div class="panel" style="margin-top:12px"><h3>Overlay's rough numbers</h3><p>${m.margin>=0?`${esc(g.home.abbr)} by ${m.margin.toFixed(1)}`:`${esc(g.away.abbr)} by ${(-m.margin).toFixed(1)}`}, total about ${m.total.toFixed(0)}.${mk!=null?` DraftKings: ${mk>=0?`${esc(g.home.abbr)} by ${mk}`:`${esc(g.away.abbr)} by ${-mk}`}${o.total!=null?`, total ${o.total}`:""}.`:""}</p>
    ${g.leans.length?`<p>${g.leans.map(l=>`<span class="lean">Lean: ${l.type==="spread"?`${esc(l.team)} ${sgn(l.line)}`:`${l.side} ${l.line}`}</span> (${l.by} points off the line)`).join(" · ")}</p>`:`<p class="sub">Close enough to the market that there's no lean.</p>`}
    <p class="sub">Built from scores only: no injuries, weather or QB changes. It went about 50/50 against the spread in testing, so use it as a second opinion, not a reason to bet.</p></div>`;
  return `<div class="panel gamepanel" id="gd"><h2>${logo(g.away,34)} ${tname(g.away)} ${g.neutral?"vs":"@"} ${logo(g.home,34)} ${tname(g.home)}</h2>
    <p class="sub">${g.state==="pre"?when(g.start):esc(g.detail)}${g.tv?` · ${esc(g.tv)}`:""}${g.conf?" · Conference game":""}${g.venue?` · ${esc(g.venue)}`:""}${g.wx?` · Kickoff forecast: ${g.wx.temp}°F, wind ${g.wx.wind} mph, ${g.wx.snow?"snow":g.wx.rain+"% rain"}`:""}</p>
    ${g.wx&&g.wx.flag?`<p class="sub"><b style="color:var(--warn)">Weather to watch:</b> strong wind and heavy rain or snow tend to cut passing and kicking.</p>`:""}
    <div class="tablebox" style="margin-top:10px"><table class="cmp"><thead><tr><th></th><th>${esc(g.away.abbr)}</th><th>${esc(g.home.abbr)}</th></tr></thead><tbody>
      <tr><td>Record</td><td class="v">${esc(g.away.rec||A.rec||"–")}</td><td class="v">${esc(g.home.rec||H.rec||"–")}</td></tr>
      ${row("Overlay rating","rating",true,"ratingRank")}${row("Points per game","ppg",true,"offRank")}${row("Points allowed","oppg",false,"defRank")}
      <tr><td>Schedule</td><td class="v">#${A.sosRank??"–"}</td><td class="v">#${H.sosRank??"–"}</td></tr></tbody></table></div>
    ${why.length?`<div class="sec">What matters</div><ul class="why">${why.map(x=>`<li>${x}</li>`).join("")}</ul>`:""}
    ${bets}${take}
    <div class="sec">Last games</div><p class="sub">${esc(g.away.abbr)}</p><div class="lastg">${last(A)}</div><p class="sub" style="margin-top:6px">${esc(g.home.abbr)}</p><div class="lastg">${last(H)}</div></div>`;}
document.addEventListener("click",e=>{const b=e.target.closest(".game");if(!b)return;state.game=state.game===b.dataset.g?null:b.dataset.g;save();renderGames();if(state.game)setTimeout(()=>$("#gd")?.scrollIntoView({behavior:"smooth",block:"start"}),30);});
function renderRatings(){const T=Object.values(D.teams).sort((a,b)=>a.ratingRank-b.ratingRank);
  $("#rtbody").innerHTML=T.map(t=>`<tr><td class="rk">${t.ratingRank}</td><td>${logo(t,18)} ${tname(t)} <span class="sub">${esc(t.conf)}</span></td><td class="num">${sgn(t.rating)}</td><td class="num">${esc(t.rec||"")}</td><td class="num">${t.ppg}</td><td class="num">${t.oppg}</td><td class="num">#${t.sosRank}</td></tr>`).join("");}
// ---------- player props (free: box scores, you type the line) ----------
const P=D.players||[];const BE=.542;
const hs=(p,size="")=>p&&p.img?`<img class="hs ${size}" src="${esc(p.img)}" alt="" loading="lazy" onerror="this.remove()">`:"";
const cdf=x=>{const t=1/(1+.2316419*Math.abs(x)),d=.3989423*Math.exp(-x*x/2),q=d*t*(.3193815+t*(-.3565638+t*(1.781478+t*(-1.821256+t*1.330274))));return x>0?1-q:q;};
function chance(pr,line,side){let pm;if(["Pass TDs","Receptions","Completions"].includes(pr.stat)&&pr.proj<12&&pr.stat!=="Completions"){const lam=Math.max(pr.proj,.05);let c=0,f=1;for(let i=0;i<=Math.floor(line);i++){if(i>0)f*=i;c+=Math.exp(-lam)*lam**i/f;}pm=1-c;}
  else pm=1-cdf((line-pr.proj)/pr.sd);return side==="More"?pm:1-pm;}
[...new Set(P.map(p=>p.game))].forEach(id=>{const g=GAME[id];if(g)$("#pgame").insertAdjacentHTML("beforeend",`<option value="${id}">${esc(g.away.abbr)} @ ${esc(g.home.abbr)}</option>`);});
$("#pgame").onchange=$("#ppos").onchange=renderProps;
const defTxt=pr=>pr.oppRank&&pr.of?`defense #${pr.of-pr.oppRank+1} of ${pr.of}`:"";
// lines you type are saved on this device, keyed player|stat
let LINES={};try{LINES=JSON.parse(localStorage.getItem("overlay-cfb-lines")||"{}");}catch(e){}
const saveLines=()=>{try{localStorage.setItem("overlay-cfb-lines",JSON.stringify(LINES));}catch(e){}};
function bestSide(pr,line){const m=chance(pr,line,"More");return m>=.5?{side:"More",ch:m}:{side:"Less",ch:1-m};}
const chip=b=>`<span class="pick ${b.side==="More"?"more":"less"}">${b.side}</span><span class="edge ${b.ch>=BE?"hot":"cold"}">${Math.round(b.ch*100)}%</span>`;
function statRow(p,i,pr,k){const key=p.id+"|"+pr.stat,ln=LINES[key];const d=pr.proj-pr.avg;
  return `<div class="statrow2"><button class="sname" data-pi="${i}" data-ki="${k}"><b>${esc(pr.stat)}</b><span class="sub">proj <b class="pv">${pr.proj}</b> <span class="delta ${d>.5?"up":d<-.5?"dn":""}" title="Projection vs his season average">${d>=0?"+":""}${d.toFixed(1)}</span> · avg ${pr.avg} · ${defTxt(pr)}</span></button>
    <span class="lin"><input type="number" inputmode="decimal" step="0.5" min="0" placeholder="Line" aria-label="PrizePicks line for ${esc(p.name)} ${esc(pr.stat)}" data-key="${esc(key)}" data-pi="${i}" data-ki="${k}" value="${ln??""}"><span class="res" id="r-${i}-${k}">${ln!=null?chip(bestSide(pr,ln)):""}</span></span></div>`;}
function renderMine(){const rows=[];P.forEach((p,i)=>p.props.forEach((pr,k)=>{const ln=LINES[p.id+"|"+pr.stat];if(ln!=null)rows.push({p,i,pr,k,ln,b:bestSide(pr,ln)});}));
  const el=$("#mine");if(!rows.length){el.hidden=true;return;}rows.sort((a,b)=>b.b.ch-a.b.ch);el.hidden=false;
  el.innerHTML=`<div class="dayhead" style="display:flex;justify-content:space-between"><span>Your lines, best first</span><button class="linkbtn" id="clearlines">Clear all</button></div>`+rows.map(r=>`<button class="mrow" data-pi="${r.i}" data-ki="${r.k}"><span><b>${esc(r.p.name)}</b> <span class="sub">${esc(r.p.team)} · ${r.b.side} ${r.ln} ${esc(r.pr.stat)}</span></span><span class="edge ${r.b.ch>=BE?"hot":"cold"}">${Math.round(r.b.ch*100)}%</span></button>`).join("")
    +`<p class="sub" style="margin:6px 0 0">Green = at or above the 54% a 6-pick Flex needs. Rough estimates from his games and this defense; college depth charts change fast, so check he's starting.</p>`;
  $("#clearlines").onclick=()=>{LINES={};saveLines();renderProps();};}
function renderProps(){const gf=$("#pgame").value,pf=$("#ppos").value;const L=P.map((p,i)=>[p,i]).filter(([p])=>(!gf||p.game===gf)&&(!pf||p.pos===pf));
  $("#plist").innerHTML=L.length?`<div class="cards" style="display:flex;flex-direction:column;gap:10px">${L.map(([p,i])=>`<div class="panel" style="padding:12px 14px"><div class="who">${hs(p)}<div><div class="pname">${esc(p.name)}</div><div class="sub">${p.pos} · ${esc(p.team)} ${p.home===false?"@":"vs"} ${p.oppRank?`<span class="trank">${p.oppRank}</span>`:""}${esc(p.opp)} · ${when(p.start)}</div></div></div>
    <div style="margin-top:6px">${p.props.map((pr,k)=>statRow(p,i,pr,k)).join("")}</div></div>`).join("")}</div>`
    :'<div class="panel"><p class="sub">No players for upcoming Top 25 games right now. They show up once the next week\'s games are on the board.</p></div>';
  renderMine();}
document.addEventListener("input",e=>{const inp=e.target.closest("input[data-key]");if(!inp)return;const v=parseFloat(inp.value);const p=P[+inp.dataset.pi],pr=p.props[+inp.dataset.ki];
  if(isNaN(v))delete LINES[inp.dataset.key];else LINES[inp.dataset.key]=v;saveLines();
  $(`#r-${inp.dataset.pi}-${inp.dataset.ki}`).innerHTML=isNaN(v)?"":chip(bestSide(pr,v));clearTimeout(renderMine.t);renderMine.t=setTimeout(renderMine,400);});
let cur=null;
function bars(L,line){const W=460,H=150,pad={l:36,r:8,t:14,b:36};const n=Math.max(L.length,1);const max=Math.max(...L.map(v=>v.v),line||0,1)*1.18;
  const y=v=>pad.t+(H-pad.t-pad.b)*(1-v/max);const bw=(W-pad.l-pad.r)/n;
  return `<svg class="chart" viewBox="0 0 ${W} ${H}" role="img" aria-label="Game log">${L.map((v,k)=>`<rect x="${pad.l+k*bw+bw*.22}" y="${y(v.v)}" width="${bw*.56}" height="${Math.max(0,y(0)-y(v.v))}" rx="2" fill="${v.v>line?"var(--pos)":"var(--line)"}"/><text x="${pad.l+k*bw+bw/2}" y="${y(v.v)-4}" text-anchor="middle">${v.v}</text><text x="${pad.l+k*bw+bw/2}" y="${H-20}" text-anchor="middle">Wk ${v.w}</text><text x="${pad.l+k*bw+bw/2}" y="${H-6}" text-anchor="middle" style="fill:var(--fg)">${v.home===false?"@":""}${esc(v.opp)}</text>`).join("")}
  <line x1="${pad.l}" x2="${W-pad.r}" y1="${y(line)}" y2="${y(line)}" stroke="var(--accent)" stroke-width="2" stroke-dasharray="5 4"/></svg><div class="sub"><span style="color:var(--accent)">- - -</span> Your line ${line}</div>`;}
function hitsHtml(pr){const hit=v=>cur.side==="More"?v.v>cur.line:v.v<cur.line;const l5=pr.log.slice(-5);const est=chance(pr,cur.line,cur.side);
  return `<div><span>Last 5</span><b>${l5.filter(hit).length}/${l5.length}</b></div><div><span>Season</span><b>${pr.log.filter(hit).length}/${pr.log.length}</b></div><div><span>Est. chance</span><b style="color:${est>=BE?"var(--pos)":"var(--fg)"}">${Math.round(est*100)}%</b></div>`;}
function openPlayer(pi,ki){const pr=P[pi].props[ki];const ln=LINES[P[pi].id+"|"+pr.stat];cur={pi,ki,side:ln!=null?bestSide(pr,ln).side:"More",line:ln??Math.max(.5,Math.round(pr.proj)-.5)};drawSheet();$("#sheet").hidden=false;$("#scrim").hidden=false;$("#sheet").scrollTop=0;}
function drawSheet(){const p=P[cur.pi],pr=p.props[cur.ki];const def=pr.oppRank&&pr.of?pr.of-pr.oppRank+1:null;
  const kind=def==null?"mid":def>pr.of*.66?"good":def<pr.of*.33?"bad":"mid";
  const verdict=def==null?"":`<div class="verdict ${kind}"><strong>${kind==="good"?"Soft":kind==="bad"?"Tough":"Average"} matchup</strong>${esc(p.opp)} ranks #${def} of ${pr.of} at stopping ${esc(pr.stat.toLowerCase())} (1 = allows the fewest). Overlay's projection: <b>${pr.proj}</b> vs his recent-weighted ${pr.base} and season average ${pr.avg}.${p.adj&&p.adj.implied?`<br><span class="sub">Also in the projection: Vegas has ${esc(p.team)} at <b>${p.adj.implied}</b> points vs ${p.adj.usual} a game so far${Math.abs(p.adj.implied-p.adj.usual)>=4?(p.adj.implied>p.adj.usual?", a bump":", a drag"):""}.</span>`:""}</div>`;
  $("#sheet").innerHTML=`<div class="sheethead"><div class="who">${hs(p,"lg")}<div><h2>${esc(p.name)}</h2><div class="sub">${p.pos} · ${esc(p.team)} ${p.home===false?"@":"vs"} ${esc(p.opp)} · ${when(p.start)}</div></div></div><button class="close" id="closebtn">Close</button></div>
    <div style="display:flex;flex-wrap:wrap;gap:6px;margin:12px 0">${p.props.map((x,k)=>`<button class="btn" data-pi="${cur.pi}" data-ki="${k}" ${k===cur.ki?'style="border-color:var(--accent);color:var(--accent)"':""}>${esc(x.stat)}</button>`).join(" ")}</div>
    <div class="checker"><div class="row"><label for="lineinput" class="sub" style="font-weight:600;letter-spacing:.06em;text-transform:uppercase">PrizePicks line</label><input type="number" id="lineinput" step="0.5" min="0" value="${cur.line}">
      <div class="seg"><button class="more" data-side="More" aria-pressed="${cur.side==="More"}">More</button><button class="less" data-side="Less" aria-pressed="${cur.side==="Less"}">Less</button></div></div>
      <div class="hits" id="hitsbox">${hitsHtml(pr)}</div><p class="sub" style="margin:6px 0 0">Needs about 54% for a 6-pick Flex. This is a rough estimate from his games and this defense, with no injury or depth-chart news, so check that he's starting.</p></div>
    ${verdict}<div class="sec">${esc(pr.stat)} by game</div><div id="logchart">${bars(pr.log,cur.line)}</div>`;
  $("#closebtn").onclick=closeSheet;
  $("#lineinput").oninput=e=>{const v=parseFloat(e.target.value);if(!isNaN(v)){cur.line=v;LINES[p.id+"|"+pr.stat]=v;saveLines();$("#hitsbox").innerHTML=hitsHtml(pr);$("#logchart").innerHTML=bars(pr.log,cur.line);}};
  document.querySelectorAll("#sheet .seg button").forEach(b=>b.onclick=()=>{cur.side=b.dataset.side;document.querySelectorAll("#sheet .seg button").forEach(x=>x.setAttribute("aria-pressed",x===b));$("#hitsbox").innerHTML=hitsHtml(pr);});}
function closeSheet(){const was=cur;$("#sheet").hidden=true;$("#scrim").hidden=true;cur=null;if(was)renderProps();}
$("#scrim").onclick=closeSheet;document.addEventListener("keydown",e=>{if(e.key==="Escape")closeSheet();});
document.addEventListener("click",e=>{const b=e.target.closest("button[data-pi]");if(b){openPlayer(+b.dataset.pi,+b.dataset.ki);}});
renderProps();
const TABS=["games","props","ratings"];
function setTab(t){if(!TABS.includes(t))t="games";state.tab=t;save();document.querySelectorAll("nav.tabs button").forEach(b=>b.setAttribute("aria-selected",b.dataset.tab===t));TABS.forEach(id=>$("#"+id).hidden=id!==t);}
document.querySelectorAll("nav.tabs button").forEach(b=>b.onclick=()=>setTab(b.dataset.tab));
renderGames();renderRatings();setTab(state.tab);
(function(){const q=new URLSearchParams(location.search);if(q.get("game")&&GAME[q.get("game")]){const g=GAME[q.get("game")];state.game=g.id;if(!g.home.rank&&!g.away.rank)state.cf="all";state.conf="";$("#cf").value=state.cf;$("#conf").value="";setTab("games");renderGames();setTimeout(()=>$("#gd")?.scrollIntoView({block:"start"}),50);}
  if(q.toString())history.replaceState(null,"",location.pathname);})();
</script>
